+        q = p[0] + p[1] * d + p[2] * d * d;
+        size = q > 0.0f ? 1.0f / sqrtf(q) + p[6] : 64.0f;   /* [gx6] */
+        if (p[3] > 0.0f && size > p[3]) size = p[3];       /* POINTSIZE_MAX */
+    } else
+        size = (float)(s_reg[0x043C / 4] & 0x1FF) / 8.0f;
+    if (!(size >= 1.0f)) size = 1.0f;
+    if (size > 64.0f) size = 64.0f;
+    return size;
