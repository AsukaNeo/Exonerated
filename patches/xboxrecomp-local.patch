+
+    if (a->pos[3] <= NV_CLIP_W) {
+        s_gpu.tris_behind++;
+        return;
+    }
+    hx = size * 0.5f * aa_scale_x();
+    hy = size * 0.5f * aa_scale_y();
+    (void)tu; (void)tv;
+    for (i = 0; i < 4; i++) {
+        q[i] = *a;
+        q[i].pos[0] += (cu[i] * 2.0f - 1.0f) * hx;
+        q[i].pos[1] += (cv[i] * 2.0f - 1.0f) * hy;
+        if (sprite)                                       /* [gx6] */
