+    out->pos[1] = clip[1] / w + o[1];
+    out->pos[2] = clip[2] / w;
+    out->pos[3] = w;
+    if (!fetch_attr(&s_gpu.attr[3], index, out->d0))
+        out->d0[0] = out->d0[1] = out->d0[2] = out->d0[3] = 1.0f;
+    if (!fetch_attr(&s_gpu.attr[4], index, out->d1))
