+/* Write the current settings to the ini: the one read at start, or a new
+ * <app>.ini in the working directory. */
+static void ov_save(void)
+{
+    char v[16];
+    int ok;
+
+    if (!s_ini[0]) {
+        char cwd[MAX_PATH];
+        if (!GetCurrentDirectoryA(sizeof cwd, cwd))
+            cwd[0] = '.', cwd[1] = 0;
+        snprintf(s_ini, sizeof s_ini, "%s\\%s.ini", cwd, s_cfg.app);
+    }
+    ok = WritePrivateProfileStringA("display", "vsync", s_cfg.vsync ? "1" : "0", s_ini);
+    ok &= WritePrivateProfileStringA("display", "filter", filter_name(s_cfg.filter), s_ini);
+    ok &= WritePrivateProfileStringA("display", "scale", scale_name(s_cfg.scale), s_ini);
+    ok &= WritePrivateProfileStringA("display", "fullscreen", s_is_fullscreen ? "1" : "0", s_ini);
+    ok &= WritePrivateProfileStringA("display", "fps_counter", s_cfg.fps_counter ? "1" : "0", s_ini);
+    snprintf(v, sizeof v, "%d", s_cfg.window_scale);
+    ok &= WritePrivateProfileStringA("display", "window_scale", v, s_ini);
+    ok &= WritePrivateProfileStringA("display", "renderer",
+                                     (s_gpu_pending < 0 ? s_cfg.gpu : s_gpu_pending)
+                                         ? "gpu" : "software", s_ini);
+    snprintf(v, sizeof v, "%d", s_render_pending ? s_render_pending : s_cfg.render_scale);
+    ok &= WritePrivateProfileStringA("display", "render_scale", v, s_ini);
+    ok &= WritePrivateProfileStringA("display", "widescreen",
+                                     (s_wide_pending < 0 ? s_cfg.widescreen : s_wide_pending) ? "1" : "0",
+                                     s_ini);
+    ok &= WritePrivateProfileStringA("input", "rumble", xbox_InputGetRumble() ? "1" : "0", s_ini);
+    snprintf(v, sizeof v, "%d", xbox_InputGetDeadZone());
+    ok &= WritePrivateProfileStringA("input", "deadzone", v, s_ini);
+    if (ok) {
+        char msg[160];
+        const char *base = strrchr(s_ini, '\\');
+        snprintf(msg, sizeof msg, "Saved to %s", base ? base + 1 : s_ini);
+        ov_status(msg);
+        fprintf(stderr, "  [FBWIN] settings saved to %s\n", s_ini);
+    } else {
+        ov_status("Could not save settings");
+        fprintf(stderr, "  [FBWIN] could not write %s\n", s_ini);
+    }
+}
