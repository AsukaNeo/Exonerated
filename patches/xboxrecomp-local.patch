+/* The quad's perpendicular for a segment from p to q, in surface pixels. */
+static void line_normal(float px, float py, float qx, float qy,
+                        float *nx, float *ny)
+{
+    float dx = qx - px, dy = qy - py, len = sqrtf(dx * dx + dy * dy);
+    if (!(len > 1e-6f)) { dx = 1.0f; dy = 0.0f; len = 1.0f; }
+    *nx = -dy / len * NV_LINE_HALF_W * aa_scale_x();
+    *ny =  dx / len * NV_LINE_HALF_W * aa_scale_y();
