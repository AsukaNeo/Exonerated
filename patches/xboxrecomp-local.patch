+static volatile LONG s_resized;       /* the client area changed size */
+static volatile LONG s_want_fullscreen_toggle, s_want_screenshot;
+static volatile LONG s_ov_open;       /* the settings overlay is up */
+static volatile LONG s_ov_key;        /* a key for the overlay, or 0 */
+static int           s_is_fullscreen;
+
+/* Borderless fullscreen on the window's monitor, and back to the window it
+ * was. Not exclusive fullscreen: Alt+Tab and a second monitor keep working,
+ * and a flip-model swapchain covering the monitor is just as fast. */
+static void toggle_fullscreen(HWND h)
+{
+    static WINDOWPLACEMENT wp = { sizeof(WINDOWPLACEMENT) };
+
+    if (!s_is_fullscreen) {
+        MONITORINFO mi = { sizeof(MONITORINFO) };
+        if (!GetWindowPlacement(h, &wp)
+            || !GetMonitorInfoA(MonitorFromWindow(h, MONITOR_DEFAULTTOPRIMARY),
+                                &mi))
+            return;
+        SetWindowLongPtrA(h, GWL_STYLE, WS_POPUP | WS_VISIBLE);
+        SetWindowPos(h, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
+                     mi.rcMonitor.right - mi.rcMonitor.left,
+                     mi.rcMonitor.bottom - mi.rcMonitor.top,
+                     SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+        s_is_fullscreen = 1;
+    } else {
+        SetWindowLongPtrA(h, GWL_STYLE, WS_OVERLAPPEDWINDOW | WS_VISIBLE);
+        SetWindowPlacement(h, &wp);
+        SetWindowPos(h, NULL, 0, 0, 0, 0,
+                     SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER
+                     | SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+        s_is_fullscreen = 0;
+    }
+    InterlockedExchange(&s_resized, 1);
+}
