+float4 texture_color_sign(float4 color,uint mask) {
+ if(mask&2)color.r=2*color.r-1;
+ if(mask&4)color.g=2*color.g-1;
+ if(mask&8)color.b=2*color.b-1;
+ if(mask&1)color.a=2*color.a-1;
+ return color;
+}
