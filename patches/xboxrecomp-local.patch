+static void ff_mul(const float m[16], const float v[4], float r[4])
+{
+    int j;
+    if (s_ff_tr < 0)
+        s_ff_tr = getenv("RECOMP_FF_TRANSPOSE") != NULL;
+    if (s_ff_tr) {
+        for (j = 0; j < 4; j++)
+            r[j] = v[0] * m[j] + v[1] * m[4 + j] + v[2] * m[8 + j] + v[3] * m[12 + j];
+        return;
+    }
+    for (j = 0; j < 4; j++)
