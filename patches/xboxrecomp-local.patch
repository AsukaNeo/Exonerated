+/* The project's logo, for the overlay's left column: an RCDATA resource
+ * named RECOMP_OVERLAY_LOGO in the exe (a PNG, decoded with WIC), cropped to
+ * the area that is not black. Embedded rather than loaded from a path, so a
+ * packaged build needs no assets folder beside it. A project without one
+ * gets the menu alone. */
+static struct {
+    int     tried;
+    HDC     dc;
+    HBITMAP bmp, old;
+    int     w, h;
+} s_logo;
+
+static void logo_load(void)
+{
+    IWICImagingFactory *fac = NULL;
+    IWICStream *st = NULL;
+    IWICBitmapDecoder *dec = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapSource *conv = NULL;
+    uint32_t *px = NULL, *dst = NULL;
+    const BYTE *png;
+    HRSRC res;
+    HGLOBAL mem;
+    DWORD size;
+    UINT w = 0, h = 0;
+    int x, y, x0, y0, x1, y1, m, cw, chh;
+    HRESULT co;
+
+    if (s_logo.tried)
+        return;
+    s_logo.tried = 1;
+    res = FindResourceA(NULL, "RECOMP_OVERLAY_LOGO", (LPCSTR)RT_RCDATA);
+    if (!res)
+        return;
+    mem = LoadResource(NULL, res);
+    size = SizeofResource(NULL, res);
+    png = mem ? (const BYTE *)LockResource(mem) : NULL;
+    if (!png || !size)
+        return;
+
+    co = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (FAILED(CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
+                                &IID_IWICImagingFactory, (void **)&fac))
+        || FAILED(IWICImagingFactory_CreateStream(fac, &st))
+        || FAILED(IWICStream_InitializeFromMemory(st, (BYTE *)png, size))
+        || FAILED(IWICImagingFactory_CreateDecoderFromStream(fac, (IStream *)st, NULL,
+                      WICDecodeMetadataCacheOnDemand, &dec))
+        || FAILED(IWICBitmapDecoder_GetFrame(dec, 0, &frame))
+        || FAILED(WICConvertBitmapSource(&GUID_WICPixelFormat32bppBGRA,
+                                         (IWICBitmapSource *)frame, &conv))
+        || FAILED(IWICBitmapSource_GetSize(conv, &w, &h)) || !w || !h)
+        goto out;
+    px = (uint32_t *)malloc((size_t)w * h * 4);
+    if (!px || FAILED(IWICBitmapSource_CopyPixels(conv, NULL, w * 4, w * h * 4,
+                                                  (BYTE *)px)))
+        goto out;
+
+    /* The bounding box of what is lit, against a black (or clear) ground. */
+    x0 = (int)w; y0 = (int)h; x1 = y1 = -1;
+    for (y = 0; y < (int)h; y++)
+        for (x = 0; x < (int)w; x++) {
+            uint32_t p = px[(size_t)y * w + x], a = p >> 24;
+            uint32_t r = (p >> 16) & 0xFF, g = (p >> 8) & 0xFF, b = p & 0xFF;
+            uint32_t v = r > g ? (r > b ? r : b) : (g > b ? g : b);
+            if (v * a / 255u > 40u) {
+                if (x < x0) x0 = x;
+                if (x > x1) x1 = x;
+                if (y < y0) y0 = y;
+                if (y > y1) y1 = y;
+            }
+        }
+    if (x1 < 0)
+        goto out;
+    m = (y1 - y0 + 1) / 10;                          /* a little air */
+    x0 = x0 - m < 0 ? 0 : x0 - m;
+    y0 = y0 - m < 0 ? 0 : y0 - m;
+    x1 = x1 + m >= (int)w ? (int)w - 1 : x1 + m;
+    y1 = y1 + m >= (int)h ? (int)h - 1 : y1 + m;
+    cw = x1 - x0 + 1;
+    chh = y1 - y0 + 1;
+
+    {
+        BITMAPINFO bi;
+        memset(&bi, 0, sizeof bi);
+        bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+        bi.bmiHeader.biWidth = cw;
+        bi.bmiHeader.biHeight = -chh;
+        bi.bmiHeader.biPlanes = 1;
+        bi.bmiHeader.biBitCount = 32;
+        bi.bmiHeader.biCompression = BI_RGB;
+        s_logo.bmp = CreateDIBSection(NULL, &bi, DIB_RGB_COLORS, (void **)&dst, NULL, 0);
+    }
+    if (!s_logo.bmp)
+        goto out;
+    for (y = 0; y < chh; y++)                       /* over black */
+        for (x = 0; x < cw; x++) {
+            uint32_t p = px[(size_t)(y0 + y) * w + (x0 + x)], a = p >> 24;
+            dst[(size_t)y * cw + x] =
+                ((((p >> 16) & 0xFF) * a / 255u) << 16)
+                | ((((p >> 8) & 0xFF) * a / 255u) << 8)
+                | ((p & 0xFF) * a / 255u);
+        }
+    s_logo.dc = CreateCompatibleDC(NULL);
+    s_logo.old = (HBITMAP)SelectObject(s_logo.dc, s_logo.bmp);
+    s_logo.w = cw;
+    s_logo.h = chh;
+    fprintf(stderr, "  [FBWIN] overlay logo %dx%d (from %ux%u)\n", cw, chh, w, h);
+
+out:
+    free(px);
+    if (conv) IWICBitmapSource_Release(conv);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (dec) IWICBitmapDecoder_Release(dec);
+    if (st) IWICStream_Release(st);
+    if (fac) IWICImagingFactory_Release(fac);
+    if (SUCCEEDED(co))
+        CoUninitialize();
+}
+
+static void logo_free(void)
+{
+    if (s_logo.dc) {
+        SelectObject(s_logo.dc, s_logo.old);
+        DeleteObject(s_logo.bmp);
+        DeleteDC(s_logo.dc);
+        s_logo.dc = NULL;
+    }
+}
+
+/* Draw the overlay for a cw x ch client area if it changed. Returns
+ * whether the image is new. */
+static int ov_prepare(int cw, int ch)
+{
+    HFONT font, bold, oldf;
+    int fh, x, y, k;
+    uint32_t a;
+
+    if (cw < 1 || ch < 1)
+        return 0;
+    if (!s_ov.dirty && s_ov.dc && s_ov.w == cw && s_ov.h == ch)
+        return 0;
+    if (!s_ov.dc || s_ov.w != cw || s_ov.h != ch) {
+        BITMAPINFO bi;
+        if (s_ov.dc) {
+            SelectObject(s_ov.dc, s_ov.old);
+            DeleteObject(s_ov.bmp);
+            DeleteDC(s_ov.dc);
+            s_ov.dc = NULL;
+        }
+        memset(&bi, 0, sizeof bi);
+        bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+        bi.bmiHeader.biWidth = cw;
+        bi.bmiHeader.biHeight = -ch;
+        bi.bmiHeader.biPlanes = 1;
+        bi.bmiHeader.biBitCount = 32;
+        bi.bmiHeader.biCompression = BI_RGB;
+        s_ov.bmp = CreateDIBSection(NULL, &bi, DIB_RGB_COLORS,
+                                    (void **)&s_ov.bits, NULL, 0);
+        if (!s_ov.bmp)
+            return 0;
+        s_ov.dc = CreateCompatibleDC(NULL);
+        s_ov.old = (HBITMAP)SelectObject(s_ov.dc, s_ov.bmp);
+        s_ov.w = cw;
+        s_ov.h = ch;
+    }
+    memset(s_ov.bits, 0, (size_t)cw * ch * 4);
+    s_ov.nrects = 0;
+
+    /* Text size: whatever lets the whole panel fit -- about 20 text heights
+     * tall, and 26 wide for the menu plus 17 for the logo column -- capped
+     * at 22 px, which reads well at 1280x960 and above. */
+    logo_load();
+    {
+        int across = 26 + (s_logo.dc ? 17 : 0) + 2;
+        int by_h = ch / 22, by_w = cw / across;
+        fh = by_h < by_w ? by_h : by_w;
+        if (fh > 22) fh = 22;
+        if (fh < 10) fh = 10;
+    }
+    font = CreateFontA(-fh, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET,
+                       OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                       ANTIALIASED_QUALITY, DEFAULT_PITCH | FF_SWISS, "Segoe UI");
+    bold = CreateFontA(-fh * 5 / 4, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET,
+                       OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                       ANTIALIASED_QUALITY, DEFAULT_PITCH | FF_SWISS, "Segoe UI");
+    oldf = (HFONT)SelectObject(s_ov.dc, font);
+    SetBkMode(s_ov.dc, TRANSPARENT);
+
+    if (s_cfg.fps_counter && s_ov.fps[0]) {
+        RECT r;
+        SetRect(&r, fh / 2, fh / 2, fh / 2 + fh * 5, fh / 2 + fh * 3 / 2);
+        ov_fill(&r, RGB(0, 0, 0));
+        ov_text(s_ov.fps, r, DT_CENTER, RGB(140, 255, 140));
+        s_ov.rects[s_ov.nrects++] = r;
+    }
+
+    if (s_ov_open) {
+        int row = fh * 3 / 2, pad = fh, lw = s_logo.dc ? fh * 17 : 0;
+        int pw = fh * 26 + lw, ph, i, ml;
+        RECT p, r;
+        if (pw > cw - fh) pw = cw - fh;
+        ph = row * (OV_COUNT + 3) + pad;
+        SetRect(&p, (cw - pw) / 2, (ch - ph) / 2, (cw + pw) / 2, (ch - ph) / 2 + ph);
+        ov_fill(&p, RGB(16, 18, 26));
+
+        /* The logo, on black like the art itself, scaled to its column. */
+        if (lw) {
+            int aw = lw - 2 * pad, ah = ph - 2 * pad, dw, dh;
+            SetRect(&r, p.left, p.top, p.left + lw, p.bottom);
+            ov_fill(&r, RGB(0, 0, 0));
+            dw = aw;
+            dh = (int)((long long)s_logo.h * aw / s_logo.w);
+            if (dh > ah) {
+                dh = ah;
+                dw = (int)((long long)s_logo.w * ah / s_logo.h);
+            }
+            SetStretchBltMode(s_ov.dc, HALFTONE);
+            SetBrushOrgEx(s_ov.dc, 0, 0, NULL);
+            StretchBlt(s_ov.dc, p.left + (lw - dw) / 2, p.top + (ph - dh) / 2, dw, dh,
+                       s_logo.dc, 0, 0, s_logo.w, s_logo.h, SRCCOPY);
+        }
+        ml = p.left + lw;                               /* the menu's left edge */
+        SetRect(&r, p.left, p.top, p.right, p.top + fh / 5);
+        ov_fill(&r, RGB(220, 40, 40));                       /* accent */
+
+        SelectObject(s_ov.dc, bold);
+        SetRect(&r, ml + pad, p.top + fh / 5, p.right - pad, p.top + row * 3 / 2);
+        {
+            char t[96];
+            if (lw)                                     /* the logo names it */
+                snprintf(t, sizeof t, "Settings");
+            else
+                snprintf(t, sizeof t, "%s settings", s_cfg.title);
+            ov_text(t, r, DT_LEFT, RGB(255, 255, 255));
+        }
+        SelectObject(s_ov.dc, font);
+
+        for (i = 0; i < OV_COUNT; i++) {
+            const char *label;
+            char value[48], shown[64];
+            int sel = i == s_ov.sel;
+            SetRect(&r, ml + pad / 2, p.top + row * 3 / 2 + row * i,
+                    p.right - pad / 2, p.top + row * 3 / 2 + row * (i + 1));
+            if (sel)
+                ov_fill(&r, RGB(70, 30, 34));
+            ov_item(i, &label, value, sizeof value);
+            r.left += pad / 2; r.right -= pad / 2;
+            ov_text(label, r, DT_LEFT, sel ? RGB(255, 255, 255) : RGB(190, 194, 205));
+            if (value[0]) {
+                snprintf(shown, sizeof shown, sel ? "<  %s  >" : "%s", value);
+                ov_text(shown, r, DT_RIGHT, sel ? RGB(255, 210, 120) : RGB(150, 200, 255));
+            }
+        }
+
+        SetRect(&r, ml + pad, p.bottom - row * 3 / 2, p.right - pad, p.bottom - pad / 3);
+        if ((LONG)(s_ov.status_until - GetTickCount()) > 0)
+            ov_text(s_ov.status, r, DT_LEFT | DT_END_ELLIPSIS, RGB(140, 255, 140));
+        else
+            ov_text("Arrows/D-pad: move   Enter/A: apply   Esc/B: close",
+                    r, DT_LEFT | DT_END_ELLIPSIS, RGB(130, 134, 145));
+        s_ov.rects[s_ov.nrects++] = p;
+    }
+    GdiFlush();
+    SelectObject(s_ov.dc, oldf);
+    DeleteObject(font);
+    DeleteObject(bold);
+
+    /* GDI leaves alpha at zero; give each drawn box its opacity. */
+    for (k = 0; k < s_ov.nrects; k++) {
+        const RECT *r = &s_ov.rects[k];
+        a = (k == s_ov.nrects - 1 && s_ov_open) ? 0xEEu : 0xC0u;
+        for (y = r->top < 0 ? 0 : r->top; y < r->bottom && y < ch; y++)
+            for (x = r->left < 0 ? 0 : r->left; x < r->right && x < cw; x++)
+                s_ov.bits[(size_t)y * cw + x] =
+                    (s_ov.bits[(size_t)y * cw + x] & 0xFFFFFFu) | (a << 24);
+    }
+    s_ov.dirty = 0;
+    return 1;
+}
+
+static void ov_free(void)
+{
+    logo_free();
+    if (s_ov.dc) {
+        SelectObject(s_ov.dc, s_ov.old);
+        DeleteObject(s_ov.bmp);
+        DeleteDC(s_ov.dc);
+        s_ov.dc = NULL;
+    }
+}
+
+/* ---- D3D11 presenter ---------------------------------------------------- */
+
+/* One full-screen triangle sampling the frame. Sharp bilinear is nearest
+ * neighbour to the largest whole multiple that fits, then bilinear for the
+ * remainder: pixels stay square-edged at any window size without the uneven
+ * columns plain nearest gives at a fractional scale. Alpha is forced to 1,
+ * since an X8R8G8B8 front buffer's top byte is whatever the title left. */
+static const char s_hlsl[] =
+    "Texture2D t : register(t0);\n"
+    "SamplerState sp : register(s0);\n"
+    "SamplerState sl : register(s1);\n"
+    "cbuffer C : register(b0) { float2 src; float2 scale; int mode; int3 pad; };\n"
+    "struct V { float4 pos : SV_Position; float2 uv : TEXCOORD0; };\n"
+    "V vs(uint id : SV_VertexID) {\n"
+    "    V o; float2 p = float2((id << 1) & 2, id & 2);\n"
+    "    o.uv = p; o.pos = float4(p * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+    "    return o;\n"
+    "}\n"
+    "float4 ps(V i) : SV_Target {\n"
+    "    float3 c;\n"
+    "    if (mode == 0) c = t.Sample(sp, i.uv).rgb;\n"
+    "    else if (mode == 1) c = t.Sample(sl, i.uv).rgb;\n"
+    "    else {\n"
+    "        float2 texel = i.uv * src;\n"
+    "        float2 k = max(floor(scale), 1.0);\n"
+    "        float2 range = 0.5 - 0.5 / k;\n"
+    "        float2 d = frac(texel) - 0.5;\n"
+    "        float2 f = (d - clamp(d, -range, range)) * k + 0.5;\n"
+    "        c = t.Sample(sl, (floor(texel) + f) / src).rgb;\n"
+    "    }\n"
+    "    return float4(c, 1);\n"
+    "}\n"
+    "Texture2D to : register(t1);\n"
+    "float4 pso(V i) : SV_Target { return to.Sample(sp, i.uv); }\n";
+
+typedef struct { float src[2], scale[2]; int mode, pad[3]; } FbConsts;
+
+static struct {
+    ID3D11Device            *dev;
+    ID3D11DeviceContext     *ctx;
+    IDXGISwapChain1         *sc;
+    ID3D11RenderTargetView  *rtv;
+    ID3D11Texture2D         *tex;
+    ID3D11ShaderResourceView *srv;
+    ID3D11VertexShader      *vs;
+    ID3D11PixelShader       *ps;
+    ID3D11SamplerState      *smp[2];
+    ID3D11Buffer            *cb;
+    ID3D11PixelShader       *pso;      /* the overlay, blended on top */
+    ID3D11BlendState        *blend;
+    ID3D11Texture2D         *ov_tex;
+    ID3D11ShaderResourceView *ov_srv;
+    int                      ov_w, ov_h;
+    UINT                     sc_flags;
+    int                      tearing;
+} d3d;
+
+#define SAFE_RELEASE(p) do { if (p) { IUnknown_Release((IUnknown *)(p)); (p) = NULL; } } while (0)
+
+static void d3d_release(void)
+{
+    if (d3d.ctx)
+        ID3D11DeviceContext_ClearState(d3d.ctx);
+    SAFE_RELEASE(d3d.rtv); SAFE_RELEASE(d3d.srv); SAFE_RELEASE(d3d.tex);
+    SAFE_RELEASE(d3d.vs);  SAFE_RELEASE(d3d.ps);  SAFE_RELEASE(d3d.cb);
+    SAFE_RELEASE(d3d.smp[0]); SAFE_RELEASE(d3d.smp[1]);
+    SAFE_RELEASE(d3d.pso); SAFE_RELEASE(d3d.blend);
+    SAFE_RELEASE(d3d.ov_srv); SAFE_RELEASE(d3d.ov_tex);
+    d3d.ov_w = d3d.ov_h = 0;
+    SAFE_RELEASE(d3d.sc);  SAFE_RELEASE(d3d.ctx); SAFE_RELEASE(d3d.dev);
+}
+
+static int d3d_make_rtv(void)
+{
+    ID3D11Texture2D *bb = NULL;
+    HRESULT hr = IDXGISwapChain1_GetBuffer(d3d.sc, 0, &IID_ID3D11Texture2D,
+                                           (void **)&bb);
+    if (FAILED(hr))
+        return 0;
+    hr = ID3D11Device_CreateRenderTargetView(d3d.dev, (ID3D11Resource *)bb,
+                                             NULL, &d3d.rtv);
+    ID3D11Texture2D_Release(bb);
+    return SUCCEEDED(hr);
+}
+
+static ID3DBlob *d3d_compile(const char *entry, const char *target)
+{
+    ID3DBlob *code = NULL, *err = NULL;
+    HRESULT hr = D3DCompile(s_hlsl, sizeof s_hlsl - 1, "fb_present", NULL,
+                            NULL, entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3,
+                            0, &code, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [FBWIN] shader %s: %s\n", entry,
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "failed");
+        SAFE_RELEASE(code);
+    }
+    SAFE_RELEASE(err);
+    return code;
+}
+
+static int d3d_init(HWND hwnd)
+{
+    static const D3D_DRIVER_TYPE types[2] = { D3D_DRIVER_TYPE_HARDWARE,
+                                              D3D_DRIVER_TYPE_WARP };
+    static const DXGI_SWAP_EFFECT effects[2] = { DXGI_SWAP_EFFECT_FLIP_DISCARD,
+                                                 DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL };
+    IDXGIDevice *xdev = NULL;
+    IDXGIAdapter *adapter = NULL;
+    IDXGIFactory2 *fac = NULL;
+    IDXGIFactory5 *fac5 = NULL;
+    DXGI_SWAP_CHAIN_DESC1 sd;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SAMPLER_DESC smd;
+    D3D11_BUFFER_DESC bd;
+    ID3DBlob *vsb = NULL, *psb = NULL;
+    HRESULT hr = E_FAIL;
+    int i, ok = 0;
+
+    memset(&d3d, 0, sizeof d3d);
+    for (i = 0; i < 2 && FAILED(hr); i++)
+        hr = D3D11CreateDevice(NULL, types[i], NULL,
+                               D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0,
+                               D3D11_SDK_VERSION, &d3d.dev, NULL, &d3d.ctx);
+    if (FAILED(hr))
+        goto out;
+    if (FAILED(ID3D11Device_QueryInterface(d3d.dev, &IID_IDXGIDevice, (void **)&xdev))
+        || FAILED(IDXGIDevice_GetAdapter(xdev, &adapter))
+        || FAILED(IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&fac)))
+        goto out;
+
+    /* Tearing lets vsync off really be off in a borderless window. */
+    if (SUCCEEDED(IDXGIFactory2_QueryInterface(fac, &IID_IDXGIFactory5, (void **)&fac5))) {
+        BOOL allow = FALSE;
+        if (SUCCEEDED(IDXGIFactory5_CheckFeatureSupport(fac5,
+                DXGI_FEATURE_PRESENT_ALLOW_TEARING, &allow, sizeof allow)))
+            d3d.tearing = allow != FALSE;
+        IDXGIFactory5_Release(fac5);
+    }
+    d3d.sc_flags = d3d.tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0;
+
+    memset(&sd, 0, sizeof sd);
+    sd.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    sd.SampleDesc.Count = 1;
+    sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    sd.BufferCount = 2;
+    sd.Flags = d3d.sc_flags;
+    hr = E_FAIL;
+    for (i = 0; i < 2 && FAILED(hr); i++) {      /* FLIP_DISCARD is Win10+ */
+        sd.SwapEffect = effects[i];
+        hr = IDXGIFactory2_CreateSwapChainForHwnd(fac, (IUnknown *)d3d.dev, hwnd,
+                                                  &sd, NULL, NULL, &d3d.sc);
+    }
+    if (FAILED(hr))
+        goto out;
+    /* Alt+Enter is ours: borderless, not DXGI's exclusive mode. */
+    IDXGIFactory2_MakeWindowAssociation(fac, hwnd, DXGI_MWA_NO_ALT_ENTER);
+    if (!d3d_make_rtv())
+        goto out;
+
+    memset(&td, 0, sizeof td);
+    td.Width = s_fb_width;
+    td.Height = s_fb_height;
+    td.MipLevels = 1;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;      /* s_rgb is 0x00RRGGBB */
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DYNAMIC;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    td.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    if (FAILED(ID3D11Device_CreateTexture2D(d3d.dev, &td, NULL, &d3d.tex))
+        || FAILED(ID3D11Device_CreateShaderResourceView(d3d.dev,
+                      (ID3D11Resource *)d3d.tex, NULL, &d3d.srv)))
+        goto out;
+
+    vsb = d3d_compile("vs", "vs_4_0");
+    psb = d3d_compile("ps", "ps_4_0");
+    if (!vsb || !psb
+        || FAILED(ID3D11Device_CreateVertexShader(d3d.dev,
+                      ID3D10Blob_GetBufferPointer(vsb), ID3D10Blob_GetBufferSize(vsb),
+                      NULL, &d3d.vs))
+        || FAILED(ID3D11Device_CreatePixelShader(d3d.dev,
+                      ID3D10Blob_GetBufferPointer(psb), ID3D10Blob_GetBufferSize(psb),
+                      NULL, &d3d.ps)))
+        goto out;
+
+    /* The overlay pass. Optional: without it the game still shows. */
+    SAFE_RELEASE(psb);
+    psb = d3d_compile("pso", "ps_4_0");
+    if (psb)
+        ID3D11Device_CreatePixelShader(d3d.dev, ID3D10Blob_GetBufferPointer(psb),
+                                       ID3D10Blob_GetBufferSize(psb), NULL, &d3d.pso);
+    {
+        D3D11_BLEND_DESC b;
+        memset(&b, 0, sizeof b);
+        b.RenderTarget[0].BlendEnable = TRUE;
+        b.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+        b.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+        b.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+        b.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+        b.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ZERO;
+        b.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+        b.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+        ID3D11Device_CreateBlendState(d3d.dev, &b, &d3d.blend);
+    }
+
+    memset(&smd, 0, sizeof smd);
+    smd.AddressU = smd.AddressV = smd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    smd.MaxLOD = D3D11_FLOAT32_MAX;
+    smd.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT;
+    if (FAILED(ID3D11Device_CreateSamplerState(d3d.dev, &smd, &d3d.smp[0])))
+        goto out;
+    smd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    if (FAILED(ID3D11Device_CreateSamplerState(d3d.dev, &smd, &d3d.smp[1])))
+        goto out;
+
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = sizeof(FbConsts);
+    bd.Usage = D3D11_USAGE_DEFAULT;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    if (FAILED(ID3D11Device_CreateBuffer(d3d.dev, &bd, NULL, &d3d.cb)))
+        goto out;
+    ok = 1;
+
+out:
+    SAFE_RELEASE(vsb); SAFE_RELEASE(psb);
+    SAFE_RELEASE(fac); SAFE_RELEASE(adapter); SAFE_RELEASE(xdev);
+    if (!ok)
+        d3d_release();
+    return ok;
+}
+
+static void d3d_resize(void)
+{
+    SAFE_RELEASE(d3d.rtv);
+    ID3D11DeviceContext_OMSetRenderTargets(d3d.ctx, 0, NULL, NULL);
+    IDXGISwapChain1_ResizeBuffers(d3d.sc, 0, 0, 0, DXGI_FORMAT_UNKNOWN,
+                                  d3d.sc_flags);
+    d3d_make_rtv();
+}
+
+/* Upload s_rgb and draw it letterboxed. Returns the Present result. */
+static HRESULT d3d_present(HWND hwnd)
+{
+    static const float black[4] = { 0, 0, 0, 1 };
+    D3D11_MAPPED_SUBRESOURCE map;
+    D3D11_VIEWPORT vp;
+    FbConsts c;
+    RECT cr;
+    int x, y, w, h;
+    uint32_t row;
+
+    if (!d3d.rtv)
+        return E_FAIL;
+    if (SUCCEEDED(ID3D11DeviceContext_Map(d3d.ctx, (ID3D11Resource *)d3d.tex, 0,
+                                          D3D11_MAP_WRITE_DISCARD, 0, &map))) {
+        for (row = 0; row < s_fb_height; row++)
+            memcpy((uint8_t *)map.pData + (size_t)row * map.RowPitch,
+                   s_rgb + (size_t)row * s_fb_width, (size_t)s_fb_width * 4);
+        ID3D11DeviceContext_Unmap(d3d.ctx, (ID3D11Resource *)d3d.tex, 0);
+    }
+
+    GetClientRect(hwnd, &cr);
+    fit_rect(cr.right, cr.bottom, &x, &y, &w, &h);
+    memset(&vp, 0, sizeof vp);
+    vp.TopLeftX = (float)x; vp.TopLeftY = (float)y;
+    vp.Width = (float)w;    vp.Height = (float)h;
+    vp.MaxDepth = 1.0f;
+
+    c.src[0] = (float)s_fb_width;  c.src[1] = (float)s_fb_height;
+    c.scale[0] = (float)w / (float)s_fb_width;
+    c.scale[1] = (float)h / (float)s_fb_height;
+    c.mode = s_cfg.filter;
+    c.pad[0] = c.pad[1] = c.pad[2] = 0;
+    ID3D11DeviceContext_UpdateSubresource(d3d.ctx, (ID3D11Resource *)d3d.cb, 0,
+                                          NULL, &c, 0, 0);
+
+    ID3D11DeviceContext_OMSetRenderTargets(d3d.ctx, 1, &d3d.rtv, NULL);
+    ID3D11DeviceContext_ClearRenderTargetView(d3d.ctx, d3d.rtv, black);
+    ID3D11DeviceContext_RSSetViewports(d3d.ctx, 1, &vp);
+    ID3D11DeviceContext_IASetPrimitiveTopology(d3d.ctx,
+                                               D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_IASetInputLayout(d3d.ctx, NULL);
+    ID3D11DeviceContext_VSSetShader(d3d.ctx, d3d.vs, NULL, 0);
+    ID3D11DeviceContext_PSSetShader(d3d.ctx, d3d.ps, NULL, 0);
+    ID3D11DeviceContext_PSSetShaderResources(d3d.ctx, 0, 1, &d3d.srv);
+    ID3D11DeviceContext_PSSetSamplers(d3d.ctx, 0, 2, d3d.smp);
+    ID3D11DeviceContext_PSSetConstantBuffers(d3d.ctx, 0, 1, &d3d.cb);
+    ID3D11DeviceContext_Draw(d3d.ctx, 3, 0);
+
+    /* The overlay, over the whole client area at its own resolution. */
+    if (ov_visible() && d3d.pso && d3d.blend) {
+        int fresh_img = ov_prepare(cr.right, cr.bottom);
+        if (s_ov.bits && (!d3d.ov_tex || d3d.ov_w != s_ov.w || d3d.ov_h != s_ov.h)) {
+            D3D11_TEXTURE2D_DESC od;
+            SAFE_RELEASE(d3d.ov_srv);
+            SAFE_RELEASE(d3d.ov_tex);
+            memset(&od, 0, sizeof od);
+            od.Width = (UINT)s_ov.w;
+            od.Height = (UINT)s_ov.h;
+            od.MipLevels = 1;
+            od.ArraySize = 1;
+            od.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+            od.SampleDesc.Count = 1;
+            od.Usage = D3D11_USAGE_DYNAMIC;
+            od.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+            od.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+            if (SUCCEEDED(ID3D11Device_CreateTexture2D(d3d.dev, &od, NULL, &d3d.ov_tex))
+                && SUCCEEDED(ID3D11Device_CreateShaderResourceView(d3d.dev,
+                                 (ID3D11Resource *)d3d.ov_tex, NULL, &d3d.ov_srv))) {
+                d3d.ov_w = s_ov.w;
+                d3d.ov_h = s_ov.h;
+                fresh_img = 1;
+            } else {
+                SAFE_RELEASE(d3d.ov_srv);
+                SAFE_RELEASE(d3d.ov_tex);
+            }
+        }
+        if (d3d.ov_srv) {
+            if (fresh_img
+                && SUCCEEDED(ID3D11DeviceContext_Map(d3d.ctx, (ID3D11Resource *)d3d.ov_tex,
+                                                     0, D3D11_MAP_WRITE_DISCARD, 0, &map))) {
+                for (row = 0; row < (uint32_t)s_ov.h; row++)
+                    memcpy((uint8_t *)map.pData + (size_t)row * map.RowPitch,
+                           s_ov.bits + (size_t)row * s_ov.w, (size_t)s_ov.w * 4);
+                ID3D11DeviceContext_Unmap(d3d.ctx, (ID3D11Resource *)d3d.ov_tex, 0);
+            }
+            vp.TopLeftX = 0; vp.TopLeftY = 0;
+            vp.Width = (float)d3d.ov_w; vp.Height = (float)d3d.ov_h;
+            ID3D11DeviceContext_RSSetViewports(d3d.ctx, 1, &vp);
+            ID3D11DeviceContext_PSSetShader(d3d.ctx, d3d.pso, NULL, 0);
+            ID3D11DeviceContext_PSSetShaderResources(d3d.ctx, 1, 1, &d3d.ov_srv);
+            ID3D11DeviceContext_OMSetBlendState(d3d.ctx, d3d.blend, NULL, 0xFFFFFFFFu);
+            ID3D11DeviceContext_Draw(d3d.ctx, 3, 0);
+            ID3D11DeviceContext_OMSetBlendState(d3d.ctx, NULL, NULL, 0xFFFFFFFFu);
+        }
+    }
+
