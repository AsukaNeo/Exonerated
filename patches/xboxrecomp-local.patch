+static const char *filter_name(int f)
+{
+    return f == FILTER_NEAREST ? "nearest" : f == FILTER_BILINEAR ? "bilinear"
+                                                                  : "sharp";
+}
+
+static const char *scale_name(int s)
+{
+    return s == SCALE_INTEGER ? "integer" : s == SCALE_STRETCH ? "stretch"
+                                                               : "fit";
+}
