+    if (len < 6 || data[0] != 0 || data[1] < 6) {
+        if (shown++ < 5) {
+            fprintf(stderr, "  [RUMBLE] pad %d: unexpected output report, %d "
+                    "bytes: %02X %02X ...\n", pad, len,
+                    len > 0 ? data[0] : 0, len > 1 ? data[1] : 0);
+            fflush(stderr);
+        }
+        return;
+    }
+    left  = (uint16_t)(data[2] | data[3] << 8);
+    right = (uint16_t)(data[4] | data[5] << 8);
+    if (left == s_rumble[pad][0] && right == s_rumble[pad][1])
+        return;
+    if (shown++ < 40) {
+        fprintf(stderr, "  [RUMBLE] pad %d: left %u right %u\n", pad,
+                (unsigned)left, (unsigned)right);
+        fflush(stderr);
+    }
+    rumble_send(pad, left, right);
+}
