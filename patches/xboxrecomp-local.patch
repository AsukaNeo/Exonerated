+/* Where the frame goes in a cw x ch client area. */
+static void fit_rect(int cw, int ch, int *x, int *y, int *w, int *h)
+{
+    int sw = display_width(), sh = (int)s_fb_height, k;
+
+    if (cw < 1) cw = 1;
+    if (ch < 1) ch = 1;
+    *w = cw; *h = ch;
+    if (s_cfg.scale == SCALE_INTEGER
+        && (k = (cw / sw < ch / sh ? cw / sw : ch / sh)) >= 1) {
+        *w = sw * k; *h = sh * k;
+    } else if (s_cfg.scale != SCALE_STRETCH) {
+        if ((long long)cw * sh > (long long)ch * sw)
+            *w = (int)((long long)ch * sw / sh);     /* pillarbox */
+        else
+            *h = (int)((long long)cw * sh / sw);     /* letterbox */
+    }
+    *x = (cw - *w) / 2;
+    *y = (ch - *h) / 2;
+}
