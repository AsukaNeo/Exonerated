+static void ov_change(HWND hwnd, int dir)
+{
+    int i;
+    switch (s_ov.sel) {
+    case OV_FULLSCREEN: toggle_fullscreen(hwnd); break;
+    case OV_VSYNC:      s_cfg.vsync = !s_cfg.vsync; break;
+    case OV_FILTER:     s_cfg.filter = (s_cfg.filter + 3 + dir) % 3; break;
+    case OV_SCALE:      s_cfg.scale = (s_cfg.scale + 3 + dir) % 3; break;
+    case OV_FPS:        s_cfg.fps_counter = !s_cfg.fps_counter; break;
+    case OV_RUMBLE:     xbox_InputSetRumble(!xbox_InputGetRumble()); break;
+    case OV_DEADZONE:
+        for (i = 0; i < DZ_STEPS - 1 && s_dz_steps[i] < xbox_InputGetDeadZone(); i++)
+            ;
+        i += dir;
+        if (i < 0) i = 0;
+        if (i >= DZ_STEPS) i = DZ_STEPS - 1;
+        xbox_InputSetDeadZone(s_dz_steps[i]);
+        break;
+    default:
+        return;
+    }
+    s_ov.dirty = 1;
+}
+
+static void ov_activate(HWND hwnd)
+{
+    switch (s_ov.sel) {
+    case OV_SCREENSHOT: take_screenshot(); ov_status(s_notice); break;
+    case OV_SAVE:       ov_save(); break;
+    case OV_CLOSE:      ov_set_open(0); break;
+    default:            ov_change(hwnd, +1); break;
+    }
+}
+
+static void ov_move(int dir)
+{
+    s_ov.sel = (s_ov.sel + OV_COUNT + dir) % OV_COUNT;
+    s_ov.dirty = 1;
+}
+
+/* A key the window passed on (fb_wndproc). */
+static void ov_key(HWND hwnd, int vk)
+{
+    if (vk == VK_F10) {
+        ov_set_open(!s_ov_open);
+        return;
+    }
+    if (!s_ov_open)
+        return;
+    switch (vk) {
+    case VK_UP:     ov_move(-1); break;
+    case VK_DOWN:   ov_move(+1); break;
+    case VK_LEFT:   ov_change(hwnd, -1); break;
+    case VK_RIGHT:  ov_change(hwnd, +1); break;
+    case VK_RETURN:
+    case VK_SPACE:  ov_activate(hwnd); break;
+    case VK_ESCAPE:
+    case VK_BACK:   ov_set_open(0); break;
+    }
+}
+
+/* The pad, read past the suspension. Back+Start opens or closes; in the
+ * menu the d-pad or left stick moves (repeating while held), A applies,
+ * B or Start closes. */
+static void ov_poll_pad(HWND hwnd)
+{
+    enum { UP = 1, DOWN = 2, LEFT = 4, RIGHT = 8, START = 0x10, BACK = 0x20,
+           A = 0x100, B = 0x200 };
+    static DWORD last_poll, held_since, last_repeat;
+    static unsigned prev;
+    XBOX_INPUT_STATE st;
+    unsigned b = 0, pressed;
+    int any = 0, i;
+    DWORD now = GetTickCount();
+
+    if (now - last_poll < 16)
+        return;
+    last_poll = now;
+    memset(&st, 0, sizeof st);
+    if (xbox_InputGetStateRaw(0, &st) == ERROR_SUCCESS) {
+        const XBOX_GAMEPAD *g = &st.Gamepad;
+        b = g->wButtons & 0x3F;
+        if (g->bAnalogButtons[XBOX_BUTTON_A] > 30) b |= A;
+        if (g->bAnalogButtons[XBOX_BUTTON_B] > 30) b |= B;
+        if (g->sThumbLY >  16000) b |= UP;
+        if (g->sThumbLY < -16000) b |= DOWN;
+        if (g->sThumbLX < -16000) b |= LEFT;
+        if (g->sThumbLX >  16000) b |= RIGHT;
+        any = g->wButtons != 0;
+        for (i = 0; i < 8; i++)
+            any |= g->bAnalogButtons[i] > 30;
+        any |= (b & 0xF) != 0;
+    }
+    if (s_ov.release_wait && !s_ov_open && !any) {
+        s_ov.release_wait = 0;
+        xbox_InputSetSuspended(0);
+    }
+    pressed = b & ~prev;
+    if ((b & (START | BACK)) == (START | BACK) && (pressed & (START | BACK))) {
+        ov_set_open(!s_ov_open);
+        prev = b;
+        return;
+    }
+    if (s_ov_open) {
+        unsigned dirs = b & 0xF;
+        if (dirs && dirs == (prev & 0xF)) {
+            if (now - held_since > 400 && now - last_repeat > 120) {
+                last_repeat = now;
+                pressed |= dirs;
+            }
+        } else {
+            held_since = now;
+        }
+        if (pressed & UP)    ov_move(-1);
+        if (pressed & DOWN)  ov_move(+1);
+        if (pressed & LEFT)  ov_change(hwnd, -1);
+        if (pressed & RIGHT) ov_change(hwnd, +1);
+        if (pressed & A)     ov_activate(hwnd);
+        if ((pressed & B) || ((pressed & START) && !(b & BACK)))
+            ov_set_open(0);
+    }
+    prev = b;
+}
+
+static void ov_fill(const RECT *r, COLORREF c)
+{
+    HBRUSH br = CreateSolidBrush(c);
+    FillRect(s_ov.dc, r, br);
+    DeleteObject(br);
+}
+
+static void ov_text(const char *s, RECT r, UINT fmt, COLORREF c)
+{
+    SetTextColor(s_ov.dc, c);
+    DrawTextA(s_ov.dc, s, -1, &r, fmt | DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX);
+}
