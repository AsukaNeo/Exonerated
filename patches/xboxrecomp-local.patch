diff --git a/src/video/pvideo_overlay.c b/src/video/pvideo_overlay.c
new file mode 100644
index 0000000..696e4e3
--- /dev/null
+++ b/src/video/pvideo_overlay.c
@@ -0,0 +1,411 @@
+/**
+ * The NV2A video overlay (PVIDEO), shown in the framebuffer window.
+ *
+ * Titles play their movies on the video scaler, not in the framebuffer: the
+ * title's own decoder writes YUY2 frames to memory and points PVIDEO at
+ * them, and on hardware the scaler blends them over the scanout -- full
+ * screen for an intro, a letterboxed band, or a strip inside a menu, where
+ * the menu leaves a hole for it. Nothing here scans out, so without this a
+ * movie the title is playing perfectly well is simply not seen.
+ *
+ * The registers are plain memory in the aperture (xbox_Nv2aRegPtr), and the
+ * kernel's acknowledgement of PVIDEO_BUFFER and PVIDEO_STOP records which
+ * buffer was handed over last and when the title stopped the overlay
+ * (xbox_memory_layout.c). That is all the scaler needs: the window draws the
+ * buffer on top of the frame, scaled to its output rectangle, and only where
+ * the frame shows the colour key when the title asked for one.
+ *
+ * RECOMP_PVIDEO=0 turns it off. RECOMP_PVIDEO_TRACE logs the registers.
+ */
+#include <stdint.h>
+
+#if defined(_WIN32)
+#define COBJMACROS
+#include <windows.h>
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern ptrdiff_t xbox_GetMemoryOffset(void);
+extern volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset);
+extern uint32_t xbox_PvideoBuffer(void);
+extern uint32_t xbox_PvideoSubmits(void);
+extern uint32_t xbox_PvideoStoppedAt(void);
+
+#define CONTIG_SIZE    (64u * 1024u * 1024u)   /* kernel.h XBOX_CONTIG_SIZE */
+
+#define PV_STOP        0x8704u
+#define PV_BASE(i)     (0x8900u + 4u * (i))
+#define PV_LIMIT(i)    (0x8908u + 4u * (i))
+#define PV_OFFSET(i)   (0x8920u + 4u * (i))
+#define PV_SIZE_IN(i)  (0x8928u + 4u * (i))
+#define PV_POINT_IN(i) (0x8930u + 4u * (i))
+#define PV_DS_DX(i)    (0x8938u + 4u * (i))
+#define PV_DT_DY(i)    (0x8940u + 4u * (i))
+#define PV_POINT_OUT(i) (0x8948u + 4u * (i))
+#define PV_SIZE_OUT(i) (0x8950u + 4u * (i))
+#define PV_FORMAT(i)   (0x8958u + 4u * (i))
+#define PV_COLOR_KEY   0x8B00u
+
+static uint32_t pv_reg(uint32_t off)
+{
+    volatile uint32_t *r = xbox_Nv2aRegPtr(off);
+    return r ? *r : 0;
+}
+
+/* What the scaler would be showing now, in guest-frame pixels. */
+typedef struct {
+    const uint8_t *pixels;           /* YUY2 rows in guest memory */
+    uint32_t pitch, in_w, in_h;
+    float    pin_s, pin_t, ds, dt;   /* source start, and step per output pixel */
+    uint32_t out_x, out_y, out_w, out_h;
+    int      keyed;                  /* only where the frame shows the key */
+    uint32_t key;
+} PvState;
+
+/* 0 when no overlay is up: never started, stopped, or no buffer handed over
+ * for half a second (a movie that ended without a stop). Only the YUY2
+ * format movies use, within the contiguous window. */
+static int pv_state(PvState *p, uint32_t fb_w, uint32_t fb_h)
+{
+    static uint32_t last_submits;
+    static DWORD last_tick;
+    uint32_t n = xbox_PvideoSubmits(), i, fmt, in, pin, out, size, addr;
+    DWORD now = GetTickCount();
+
+    if (n != last_submits) {
+        last_submits = n;
+        last_tick = now;
+    }
+    if (!n || n == xbox_PvideoStoppedAt() || now - last_tick > 500)
+        return 0;
+    i = (xbox_PvideoBuffer() & 0x10u) ? 1 : 0;
+    fmt = pv_reg(PV_FORMAT(i));
+    if (((fmt >> 16) & 3u) != 1u)    /* LE_CR8YB8CB8YA8: bytes Y0 U Y1 V */
+        return 0;
+    out = pv_reg(PV_POINT_OUT(i));
+    size = pv_reg(PV_SIZE_OUT(i));
+    p->out_x = out & 0xFFFu;
+    p->out_y = (out >> 16) & 0xFFFu;
+    p->out_w = size & 0xFFFu;
+    p->out_h = (size >> 16) & 0xFFFu;
+    if (!p->out_w || !p->out_h || p->out_x >= fb_w || p->out_y >= fb_h)
+        return 0;
+    /* SIZE_IN reads all ones for a moment while the title rewrites it. */
+    in = pv_reg(PV_SIZE_IN(i));
+    p->in_w = in & 0x7FFu;
+    p->in_h = (in >> 16) & 0x7FFu;
+    if (in == 0xFFFFFFFFu || !p->in_w || !p->in_h) {
+        p->in_w = p->out_w;
+        p->in_h = p->out_h;
+    }
+    p->pitch = fmt & 0x1FFFu;
+    if (p->pitch < p->in_w * 2)
+        return 0;
+    pin = pv_reg(PV_POINT_IN(i));
+    p->pin_s = (float)(pin & 0x7FFFu) / 16.0f;      /* 12.4 */
+    p->pin_t = (float)(pin >> 17) / 8.0f;           /* 12.3, from bit 17 */
+    p->ds = (float)pv_reg(PV_DS_DX(i)) / 1048576.0f; /* 12.20 */
+    p->dt = (float)pv_reg(PV_DT_DY(i)) / 1048576.0f;
+    if (p->ds <= 0.0f || p->ds > 16.0f) p->ds = 1.0f;
+    if (p->dt <= 0.0f || p->dt > 16.0f) p->dt = 1.0f;
+    addr = pv_reg(PV_BASE(i)) + pv_reg(PV_OFFSET(i));
+    if (!addr || (uint64_t)addr + (uint64_t)p->pitch * p->in_h > CONTIG_SIZE)
+        return 0;
+    /* Physical P is visible at 0x80000000 + P (the contiguous window). */
+    p->pixels = (const uint8_t *)((uintptr_t)(0x80000000u + addr) + xbox_GetMemoryOffset());
+    p->keyed = (fmt & 0x00100000u) != 0;            /* DISPLAY_COLOR_KEY */
+    p->key = pv_reg(PV_COLOR_KEY);
+    return 1;
+}
+
+/* RECOMP_PVIDEO_TRACE: the shown buffer's registers whenever they change. */
+void xbox_PvideoTrace(void)
+{
+    static int on = -1, lines;
+    static uint32_t last[12];
+    uint32_t cur[12], i = (xbox_PvideoBuffer() & 0x10u) ? 1 : 0, j;
+    int changed = 0;
+
+    if (on < 0)
+        on = getenv("RECOMP_PVIDEO_TRACE") != NULL;
+    if (!on || lines > 400)
+        return;
+    cur[0] = xbox_PvideoBuffer();       cur[1] = xbox_PvideoStoppedAt() == xbox_PvideoSubmits();
+    cur[2] = pv_reg(PV_BASE(i)) + pv_reg(PV_OFFSET(i));
+    cur[3] = pv_reg(PV_SIZE_IN(i));     cur[4] = pv_reg(PV_POINT_IN(i));
+    cur[5] = pv_reg(PV_DS_DX(i));       cur[6] = pv_reg(PV_DT_DY(i));
+    cur[7] = pv_reg(PV_POINT_OUT(i));   cur[8] = pv_reg(PV_SIZE_OUT(i));
+    cur[9] = pv_reg(PV_FORMAT(i));      cur[10] = pv_reg(PV_COLOR_KEY);
+    cur[11] = pv_reg(PV_LIMIT(i));
+    for (j = 0; j < 12; j++)
+        changed |= j != 2 && cur[j] != last[j];   /* not each new frame */
+    if (!changed)
+        return;
+    memcpy(last, cur, sizeof last);
+    lines++;
+    fprintf(stderr, "  [PVIDEO] buf %X stopped %u addr %08X in %08X pin %08X ds %08X "
+            "dt %08X pout %08X sout %08X fmt %08X key %08X lim %08X\n",
+            cur[0], cur[1], cur[2], cur[3], cur[4], cur[5], cur[6], cur[7], cur[8],
+            cur[9], cur[10], cur[11]);
+}
+
+/* A count that changes whenever the overlay may look different, so the
+ * window draws again even when the title is not flipping. */
+uint32_t xbox_PvideoChangeCount(void)
+{
+    return xbox_PvideoSubmits();
+}
+
+/* ---- D3D11 pass ----------------------------------------------------------
+ *
+ * The YUY2 rows go up as they are, one RGBA texel per pixel pair (r Y0,
+ * g U, b Y1, a V), and the shader unpacks, converts (BT.601, video range)
+ * and filters them: bilinear between converted pixels, so the packing never
+ * blends a luma with a chroma byte. */
+static const char s_pv_hlsl[] =
+    "Texture2D frame : register(t0);\n"
+    "Texture2D<float4> yuy2 : register(t1);\n"
+    "SamplerState sp : register(s0);\n"
+    "cbuffer P : register(b0) { float2 pin; float2 step; float2 outsz; float2 insz;\n"
+    "                           float2 fuv0; float2 fuv1; float4 key; int keyed; int3 pad; };\n"
+    "struct V { float4 pos : SV_Position; float2 uv : TEXCOORD0; };\n"
+    "V vs(uint id : SV_VertexID) {\n"
+    "    V o; float2 p = float2((id << 1) & 2, id & 2);\n"
+    "    o.uv = p; o.pos = float4(p * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+    "    return o;\n"
+    "}\n"
+    "float3 px(int2 p) {\n"
+    "    p = clamp(p, int2(0, 0), int2(insz) - 1);\n"
+    "    float4 q = yuy2.Load(int3(p.x >> 1, p.y, 0));\n"
+    "    float y = 1.164 * (((p.x & 1) ? q.b : q.r) - 0.0625);\n"
+    "    float u = q.g - 0.5, v = q.a - 0.5;\n"
+    "    return saturate(float3(y + 1.596 * v, y - 0.813 * v - 0.391 * u, y + 2.018 * u));\n"
+    "}\n"
+    "float4 ps(V i) : SV_Target {\n"
+    "    if (keyed) {\n"
+    "        float3 f = frame.Sample(sp, lerp(fuv0, fuv1, i.uv)).rgb;\n"
+    "        if (any(abs(f - key.rgb) > 1.5 / 255.0)) discard;\n"
+    "    }\n"
+    "    float2 s = pin + i.uv * outsz * step - 0.5;\n"
+    "    int2 b = (int2)floor(s); float2 t = s - b;\n"
+    "    float3 c = lerp(lerp(px(b), px(b + int2(1, 0)), t.x),\n"
+    "                    lerp(px(b + int2(0, 1)), px(b + int2(1, 1)), t.x), t.y);\n"
+    "    return float4(c, 1);\n"
+    "}\n";
+
+typedef struct {
+    float pin[2], step[2], outsz[2], insz[2], fuv0[2], fuv1[2], key[4];
+    int   keyed, pad[3];
+} PvConsts;
+
+static struct {
+    ID3D11Device             *dev;      /* the device these belong to */
+    ID3D11VertexShader       *vs;
+    ID3D11PixelShader        *ps;
+    ID3D11SamplerState       *smp;
+    ID3D11Buffer             *cb;
+    ID3D11Texture2D          *tex;
+    ID3D11ShaderResourceView *srv;
+    uint32_t                  tw, th;
+    int                       failed;
+    int                       logged;
+} pvd;
+
+#define PV_RELEASE(p) do { if (p) { IUnknown_Release((IUnknown *)(p)); (p) = NULL; } } while (0)
+
+void xbox_PvideoReleaseD3D11(void)
+{
+    PV_RELEASE(pvd.srv); PV_RELEASE(pvd.tex);
+    PV_RELEASE(pvd.cb);  PV_RELEASE(pvd.smp);
+    PV_RELEASE(pvd.ps);  PV_RELEASE(pvd.vs);
+    memset(&pvd, 0, sizeof pvd);
+}
+
+static ID3DBlob *pv_compile(const char *entry, const char *target)
+{
+    ID3DBlob *code = NULL, *err = NULL;
+    if (FAILED(D3DCompile(s_pv_hlsl, sizeof s_pv_hlsl - 1, "pvideo_overlay", NULL, NULL,
+                          entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &err))) {
+        fprintf(stderr, "  [PVIDEO] shader %s: %s\n", entry,
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "failed");
+        PV_RELEASE(code);
+    }
+    PV_RELEASE(err);
+    return code;
+}
+
+static int pv_init(ID3D11Device *dev)
+{
+    ID3DBlob *vsb, *psb;
+    D3D11_SAMPLER_DESC smd;
+    D3D11_BUFFER_DESC bd;
+    int ok;
+
+    pvd.dev = dev;
+    vsb = pv_compile("vs", "vs_4_0");
+    psb = pv_compile("ps", "ps_4_0");
+    memset(&smd, 0, sizeof smd);
+    smd.AddressU = smd.AddressV = smd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    smd.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT;
+    smd.MaxLOD = D3D11_FLOAT32_MAX;
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = sizeof(PvConsts);
+    bd.Usage = D3D11_USAGE_DEFAULT;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    ok = vsb && psb
+        && SUCCEEDED(ID3D11Device_CreateVertexShader(dev, ID3D10Blob_GetBufferPointer(vsb),
+                         ID3D10Blob_GetBufferSize(vsb), NULL, &pvd.vs))
+        && SUCCEEDED(ID3D11Device_CreatePixelShader(dev, ID3D10Blob_GetBufferPointer(psb),
+                         ID3D10Blob_GetBufferSize(psb), NULL, &pvd.ps))
+        && SUCCEEDED(ID3D11Device_CreateSamplerState(dev, &smd, &pvd.smp))
+        && SUCCEEDED(ID3D11Device_CreateBuffer(dev, &bd, NULL, &pvd.cb));
+    PV_RELEASE(vsb);
+    PV_RELEASE(psb);
+    if (!ok) {
+        xbox_PvideoReleaseD3D11();
+        pvd.failed = 1;
+    }
+    return ok;
+}
+
+/* Upload the shown buffer into a texture of its size. */
+static int pv_upload(ID3D11Device *dev, ID3D11DeviceContext *ctx, const PvState *p)
+{
+    D3D11_MAPPED_SUBRESOURCE map;
+    uint32_t tw = (p->in_w + 1) / 2, row;
+
+    if (!pvd.tex || pvd.tw != tw || pvd.th != p->in_h) {
+        D3D11_TEXTURE2D_DESC td;
+        PV_RELEASE(pvd.srv);
+        PV_RELEASE(pvd.tex);
+        memset(&td, 0, sizeof td);
+        td.Width = tw;
+        td.Height = p->in_h;
+        td.MipLevels = 1;
+        td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DYNAMIC;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        td.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        if (FAILED(ID3D11Device_CreateTexture2D(dev, &td, NULL, &pvd.tex))
+            || FAILED(ID3D11Device_CreateShaderResourceView(dev, (ID3D11Resource *)pvd.tex,
+                                                            NULL, &pvd.srv))) {
+            PV_RELEASE(pvd.srv);
+            PV_RELEASE(pvd.tex);
+            return 0;
+        }
+        pvd.tw = tw;
+        pvd.th = p->in_h;
+    }
+    if (FAILED(ID3D11DeviceContext_Map(ctx, (ID3D11Resource *)pvd.tex, 0,
+                                       D3D11_MAP_WRITE_DISCARD, 0, &map)))
+        return 0;
+    for (row = 0; row < p->in_h; row++)
+        memcpy((uint8_t *)map.pData + (size_t)row * map.RowPitch,
+               p->pixels + (size_t)row * p->pitch, (size_t)tw * 4);
+    ID3D11DeviceContext_Unmap(ctx, (ID3D11Resource *)pvd.tex, 0);
+    return 1;
+}
+
+/* Draw the overlay, if one is up, over a frame already drawn at (x, y, w, h)
+ * of the bound render target; frame is that frame's texture, fb_w x fb_h
+ * the guest's frame size. Leaves the pipeline state as it found it. 1 when
+ * something was drawn. */
+int xbox_PvideoDrawD3D11(void *device, void *context, void *frame_srv,
+                         float x, float y, float w, float h,
+                         uint32_t fb_w, uint32_t fb_h)
+{
+    static int enabled = -1;
+    ID3D11Device *dev = (ID3D11Device *)device;
+    ID3D11DeviceContext *ctx = (ID3D11DeviceContext *)context;
+    ID3D11ShaderResourceView *frame = (ID3D11ShaderResourceView *)frame_srv;
+    ID3D11VertexShader *old_vs = NULL;
+    ID3D11PixelShader *old_ps = NULL;
+    ID3D11Buffer *old_cb = NULL;
+    ID3D11SamplerState *old_smp = NULL;
+    ID3D11ShaderResourceView *old_srv[2] = { NULL, NULL }, *srvs[2];
+    D3D11_VIEWPORT old_vp, vp;
+    UINT nvp = 1;
+    PvState p;
+    PvConsts c;
+
+    if (enabled < 0) {
+        const char *v = getenv("RECOMP_PVIDEO");
+        enabled = !(v && *v == '0');
+    }
+    if (!enabled || !fb_w || !fb_h || !pv_state(&p, fb_w, fb_h))
+        return 0;
+    if (pvd.dev != dev) {
+        xbox_PvideoReleaseD3D11();
+        if (!pv_init(dev))
+            return 0;
+    }
+    if (pvd.failed || !pv_upload(dev, ctx, &p))
+        return 0;
+    if (!pvd.logged) {
+        pvd.logged = 1;
+        fprintf(stderr, "  [PVIDEO] showing the video overlay: %ux%u at %u,%u (%ux%u in)\n",
+                p.out_w, p.out_h, p.out_x, p.out_y, p.in_w, p.in_h);
+    }
+
+    memset(&c, 0, sizeof c);
+    c.pin[0] = p.pin_s;  c.pin[1] = p.pin_t;
+    c.step[0] = p.ds;    c.step[1] = p.dt;
+    c.outsz[0] = (float)p.out_w;  c.outsz[1] = (float)p.out_h;
+    c.insz[0] = (float)p.in_w;    c.insz[1] = (float)p.in_h;
+    c.fuv0[0] = (float)p.out_x / (float)fb_w;
+    c.fuv0[1] = (float)p.out_y / (float)fb_h;
+    c.fuv1[0] = (float)(p.out_x + p.out_w) / (float)fb_w;
+    c.fuv1[1] = (float)(p.out_y + p.out_h) / (float)fb_h;
+    c.key[0] = (float)((p.key >> 16) & 255u) / 255.0f;
+    c.key[1] = (float)((p.key >> 8) & 255u) / 255.0f;
+    c.key[2] = (float)(p.key & 255u) / 255.0f;
+    c.keyed = p.keyed && frame;
+    ID3D11DeviceContext_UpdateSubresource(ctx, (ID3D11Resource *)pvd.cb, 0, NULL, &c, 0, 0);
+
+    memset(&vp, 0, sizeof vp);
+    vp.TopLeftX = x + (float)p.out_x * w / (float)fb_w;
+    vp.TopLeftY = y + (float)p.out_y * h / (float)fb_h;
+    vp.Width = (float)p.out_w * w / (float)fb_w;
+    vp.Height = (float)p.out_h * h / (float)fb_h;
+    vp.MaxDepth = 1.0f;
+
+    ID3D11DeviceContext_RSGetViewports(ctx, &nvp, &old_vp);
+    ID3D11DeviceContext_VSGetShader(ctx, &old_vs, NULL, NULL);
+    ID3D11DeviceContext_PSGetShader(ctx, &old_ps, NULL, NULL);
+    ID3D11DeviceContext_PSGetConstantBuffers(ctx, 0, 1, &old_cb);
+    ID3D11DeviceContext_PSGetSamplers(ctx, 0, 1, &old_smp);
+    ID3D11DeviceContext_PSGetShaderResources(ctx, 0, 2, old_srv);
+
+    srvs[0] = frame;
+    srvs[1] = pvd.srv;
+    ID3D11DeviceContext_RSSetViewports(ctx, 1, &vp);
+    ID3D11DeviceContext_IASetPrimitiveTopology(ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_IASetInputLayout(ctx, NULL);
+    ID3D11DeviceContext_VSSetShader(ctx, pvd.vs, NULL, 0);
+    ID3D11DeviceContext_PSSetShader(ctx, pvd.ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(ctx, 0, 1, &pvd.cb);
+    ID3D11DeviceContext_PSSetSamplers(ctx, 0, 1, &pvd.smp);
+    ID3D11DeviceContext_PSSetShaderResources(ctx, 0, 2, srvs);
+    ID3D11DeviceContext_Draw(ctx, 3, 0);
+
+    if (nvp)
+        ID3D11DeviceContext_RSSetViewports(ctx, 1, &old_vp);
+    ID3D11DeviceContext_VSSetShader(ctx, old_vs, NULL, 0);
+    ID3D11DeviceContext_PSSetShader(ctx, old_ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(ctx, 0, 1, &old_cb);
+    ID3D11DeviceContext_PSSetSamplers(ctx, 0, 1, &old_smp);
+    ID3D11DeviceContext_PSSetShaderResources(ctx, 0, 2, old_srv);
+    PV_RELEASE(old_vs); PV_RELEASE(old_ps); PV_RELEASE(old_cb); PV_RELEASE(old_smp);
+    PV_RELEASE(old_srv[0]); PV_RELEASE(old_srv[1]);
+    return 1;
+}
