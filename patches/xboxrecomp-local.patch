+int xbox_gdlock_insn(const char *text, uint32_t va)
+{
+    if (!text || !gd_enabled())
+        return 0;
+    if (!strcmp(text, "cli")) {
+        gd_note_site("cli", va);
+        gd_cli(va);
+        return 1;
+    }
+    if (!strcmp(text, "sti")) {
+        gd_note_site("sti", va);
