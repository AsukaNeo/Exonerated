+static void gd_sti(void)
+{
+    if (t_gd_cli) {
+        if (t_gd_cli_int)  gd_release(s_gd_intp);
+        if (t_gd_cli_disp) gd_release(&s_gd_disp);
+        t_gd_cli = t_gd_cli_int = t_gd_cli_disp = 0;
+    }
