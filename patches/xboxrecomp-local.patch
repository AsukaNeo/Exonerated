+    return gpu_tex_level(ctx, face, 0, x, y, argb);
+}
+
+static uint32_t gpu_texel_bytes(uint32_t fmt)
+{
+    return (fmt == 0x24 || fmt == 0x25) ? 2u : tex_texel_bytes(fmt);
+}
+
+/* Stage `stage` as the back end wants it. 0 = the batch goes to the CPU. */
+static int gpu_bind_texture(uint32_t stage, uint32_t mode, Nv2aGpuTexture *b)
+{
+    const Texture *t = &s_gpu.texs[stage];
+    uint32_t r = (0x1B00 + 0x40 * stage) / 4;
+    uint32_t raw = s_reg[r + 1], addr = s_reg[r + 2];
+    uint32_t block = d3d8_format_dxt_block_bytes(t->color);
+    uint32_t levels, maxl = 1, dim, l, k;
+    uint64_t bytes = 0;
+
+    b->control0 = s_reg[r + 3];
+    b->control0_valid = 1;
+    b->filter = t->filter;
+    if (!nv2a_gpu_texture_mode_samples(mode))
+        return 1;
+    if (!nv2a_gpu_texture_enabled(b) || !t->valid) {
+        /* A disabled or unprogrammed stage reads white, as the CPU sampler
+         * does for a texel it cannot read. */
+        b->disabled = 1;
+        b->width = b->height = 1;
+        b->pitch = 4;
+        b->mip_levels = 1;
+        return 1;
+    }
+    if (((raw >> 4) & 15u) == 3u)
+        return gpu_reject("volume texture");
+    b->source = (const uint8_t *)xbox_GetMemoryOffset() + t->offset;
+    b->width = t->width;
+    b->height = t->height;
+    b->pitch = t->pitch;
+    b->format = t->color;
+    b->linear = !tex_size_from_format(t->color);
+    b->address_u = addr & 15u;
+    b->address_v = (addr >> 8) & 15u;
+    b->address_w = (addr >> 16) & 15u;
+    b->border_color = s_reg[r + 9];                       /* 0x1B24 */
+    b->color_key = s_reg[(0x0AE0 / 4) + stage];
+    for (k = 0; k < 4; k++)
+        memcpy(&b->bump_matrix[k], &s_reg[r + 10 + k], 4); /* 0x1B28.. */
+    memcpy(&b->bump_scale, &s_reg[r + 14], 4);
+    memcpy(&b->bump_offset, &s_reg[r + 15], 4);
+    levels = b->linear ? 1u : (t->levels ? t->levels : 1u);
+    dim = t->width > t->height ? t->width : t->height;
+    while (dim > 1) { dim >>= 1; maxl++; }
+    if (levels > maxl)
+        levels = maxl;
+    b->mip_levels = levels;
+    if (b->linear && !block && t->pitch < t->width * gpu_texel_bytes(t->color))
+        return gpu_reject("linear texture pitch");
+    for (l = 0; l < levels; l++) {
+        uint32_t w = (t->width >> l) ? (t->width >> l) : 1;
+        uint32_t h = (t->height >> l) ? (t->height >> l) : 1;
+        bytes += block ? (uint64_t)((w + 3) / 4) * ((h + 3) / 4) * block
+               : b->linear ? (uint64_t)t->pitch * t->height
+               : (uint64_t)w * h * gpu_texel_bytes(t->color);
+    }
+    s_gpu_tex[stage].t = *t;
+    s_gpu_tex[stage].face_stride = 0;
+    b->decode_context = &s_gpu_tex[stage];
+    b->decode = gpu_tex_plain;
+    if (levels > 1)
+        b->decode_level = gpu_tex_level;
+    if (t->cube) {
+        if (t->width != t->height || b->linear)
+            return gpu_reject("cube texture shape");
+        b->cube = 1;
+        b->face_stride = s_gpu_tex[stage].face_stride = tex_face_stride(t);
+        b->decode_face = gpu_tex_face;
+        bytes = (uint64_t)b->face_stride * 6;
+    }
+    if (!bytes || bytes > 0x4000000u || !guest_span_ok(t->offset, (uint32_t)bytes))
+        return gpu_reject("texture memory extent");
+    b->source_bytes = (uint32_t)bytes;
+    return 1;
+}
+
+static void gpu_combiners(Nv2aCpuCombiners *c)
+{
+    const Nv2aCombiner *rc = &s_gpu.rc;
+    uint32_t i, f = s_gpu.fog_color;
+
+    c->control = rc->control;
+    memcpy(c->rgb_input, rc->color_icw, sizeof c->rgb_input);
+    memcpy(c->alpha_input, rc->alpha_icw, sizeof c->alpha_input);
+    memcpy(c->rgb_output, rc->color_ocw, sizeof c->rgb_output);
+    memcpy(c->alpha_output, rc->alpha_ocw, sizeof c->alpha_output);
+    c->final_input[0] = rc->final0;
+    c->final_input[1] = rc->final1;
+    for (i = 0; i < 8; i++) {
+        nv_cpu_unpack_argb(rc->factor0[i], c->factors[i][0]);
+        nv_cpu_unpack_argb(rc->factor1[i], c->factors[i][1]);
+    }
+    nv_cpu_unpack_argb(rc->final_c0, c->factors[8][0]);
+    nv_cpu_unpack_argb(rc->final_c1, c->factors[8][1]);
+    /* FOG_COLOR carries red in bits 0-7. */
+    nv_cpu_unpack_argb((f & 0xFF00FF00u) | ((f & 0xFFu) << 16) | ((f >> 16) & 0xFFu),
+                       c->fog_color);
+}
+
+/* The fixed-function constant file as the hardware lays it out (xemu's
+ * XFCTX slots): composite 0-3, projection 4-7, model-view k at 8+8k, its
+ * inverse at 12+8k, texgen planes at 64+8s, texture matrices at 68+8s, the
+ * viewport at 58/59. Built from the register mirror into a copy, so a vertex
+ * program's own constants are left alone. */
+static float s_gpu_ffc[NV2A_VSH_CONSTANTS][4];
+
+static void gpu_ff_matrices(uint32_t method, uint32_t first_row, uint32_t count)
+{
+    uint32_t e;
+    for (e = 0; e < count * 16; e++)
+        memcpy(&s_gpu_ffc[first_row + (e / 16) * 8 + (e % 16) / 4][e % 4],
+               &s_reg[method / 4 + e], 4);
+}
+
+static void gpu_ff_constants(void)
+{
+    uint32_t e;
+    memcpy(s_gpu_ffc, nv2a_vsh_constant_file(), sizeof s_gpu_ffc);
+    for (e = 0; e < 16; e++) {
+        memcpy(&s_gpu_ffc[e / 4][e % 4], &s_reg[0x0680 / 4 + e], 4);    /* composite */
+        memcpy(&s_gpu_ffc[4 + e / 4][e % 4], &s_reg[0x0440 / 4 + e], 4); /* projection */
+    }
+    gpu_ff_matrices(0x0480, 8, 4);                          /* model-view 0-3 */
+    gpu_ff_matrices(0x0580, 12, 4);                         /* inverse model-view */
+    gpu_ff_matrices(0x0840, 64, 4);                         /* texgen planes */
+    gpu_ff_matrices(0x06C0, 68, 4);                         /* texture matrices */
+}
+
+/* The batch being assembled: its state, and its vertices de-duplicated by
+ * index within a chunk (a chunk is what one nv2a_gpu_draw takes). */
+static Nv2aGpuDraw s_gstate;
+static Nv2aGpuVertex *s_gv;
+static uint32_t *s_gi, s_gv_cap, s_gi_cap, s_gv_count, s_gi_count, s_gchunks;
+static uint32_t s_gtag[65536], s_goff[65536], s_gkey[65536], s_gserial;
+static int s_gkind;
+static uint32_t s_gmask, s_gvalid[NV2A_VSH_SLOTS];
+
+static void gpu_chunk_begin(void)
+{
+    s_gv_count = s_gi_count = 0;
+    if (++s_gserial == 0) {
+        memset(s_gtag, 0, sizeof s_gtag);
+        s_gserial = 1;
+    }
+}
+
+static void gpu_fill_vertex(uint32_t index, Nv2aGpuVertex *d)
+{
+    float fog[4];
+    uint32_t a;
+
+    if (s_gkind == GPU_PROGRAM) {
+        /* Raw attributes; the program reads nothing else. */
+        for (a = 0; a < NV2A_VSH_INPUTS; a++)
+            if (s_gmask & (1u << a))
+                fetch_attr(&s_gpu.attr[a], index, d->attributes[a]);
+            else
+                memset(d->attributes[a], 0, sizeof d->attributes[a]);
+        memcpy(d->position, d->attributes[0], sizeof d->position);
+        return;
+    }
+    memset(d, 0, offsetof(Nv2aGpuVertex, attributes));
+    fetch_attr(&s_gpu.attr[0], index, d->position);
+    if (s_gkind == GPU_FIXED) {                     /* as ff_transform_vertex */
+        if (!fetch_attr(&s_gpu.attr[3], index, d->diffuse))
+            d->diffuse[0] = d->diffuse[1] = d->diffuse[2] = d->diffuse[3] = 1.0f;
+        if (!fetch_attr(&s_gpu.attr[4], index, d->specular))
+            d->specular[3] = 0.0f;
+        fetch_attr(&s_gpu.attr[2], index, d->normal);
+        fetch_attr(&s_gpu.attr[1], index, d->weights);
+        for (a = 0; a < 4; a++)
+            fetch_attr(&s_gpu.attr[9 + a], index, d->texture[a]);
+    } else {                                        /* screen space, as raster_indexed */
+        d->position[3] = 1.0f;
+        if (!fetch_attr(color_attr(), index, d->diffuse))
+            d->diffuse[0] = d->diffuse[1] = d->diffuse[2] = d->diffuse[3] = 1.0f;
+        fetch_attr(&s_gpu.attr[4], index, d->specular);
+        fetch_attr(texcoord_attr(), index, d->texture[0]);
+        for (a = 1; a < 4; a++)
+            fetch_attr(&s_gpu.attr[9 + a], index, d->texture[a]);
+    }
+    fetch_attr(&s_gpu.attr[5], index, fog);
+    d->fog_coordinate = fog[0];
+}
+
+static int gpu_submit(void)
+{
+    if (!s_gv_count)
+        return 1;
+    s_gstate.indices = s_gi;
+    s_gstate.index_count = s_gi_count;
+    if (s_gpu.zpass_enable)                       /* visibility test: count */
+        nv2a_gpu_zpass_begin();
+    if (!nv2a_gpu_draw(&s_gstate, s_gv, s_gv_count)) {
+        if (s_gpu.zpass_enable)
+            s_gpu.zpass_count += (uint32_t)nv2a_gpu_zpass_end();
+        return 0;
+    }
+    if (s_gpu.zpass_enable) {
+        s_gpu.zpass_count += (uint32_t)nv2a_gpu_zpass_end();
+        s_gpu_stat.zpass_batches++;
+    }
+    s_gpu_pending = 1;
+    if (!s_gchunks)
+        gpu_note_surface();
+    s_gchunks++;
+    if (s_gstate.topology == NV2A_GPU_TOPOLOGY_TRIANGLES)
+        s_gpu.tris_drawn += s_gi_count / 3;
+    return 1;
+}
+
+static int gpu_append(const uint32_t *idx, uint32_t n)
+{
+    uint32_t v;
+    if (s_gv_count + n > s_gv_cap || s_gi_count + n > s_gi_cap) {
+        if (!gpu_submit())
+            return 0;
+        gpu_chunk_begin();
+    }
+    for (v = 0; v < n; v++) {
+        uint32_t index = idx[v], slot = index & 0xFFFFu;
+        if (s_gtag[slot] == s_gserial && s_gkey[slot] == index) {
+            s_gi[s_gi_count++] = s_goff[slot];
+            continue;
+        }
+        s_gtag[slot] = s_gserial;
+        s_gkey[slot] = index;
+        s_goff[slot] = s_gv_count;
+        s_gi[s_gi_count++] = s_gv_count;
+        gpu_fill_vertex(index, &s_gv[s_gv_count++]);
+    }
+    return 1;
+}
+
+static int gpu_tri(uint32_t a, uint32_t b, uint32_t c)
+{
+    const uint32_t t[3] = { a, b, c };
+    return gpu_append(t, 3);
+}
+
+/* Which path a batch takes, the same choice raster_batch makes; -1 = CPU. */
+static int gpu_batch_kind(void)
+{
+    static int ff_up = -1, no_ff = -1, kinds = -1;
+    int kind;
+    if (ff_up < 0) {
+        const char *k = getenv("RECOMP_GPU_KINDS");  /* 1 program, 2 fixed, 4 screen */
+        ff_up = getenv("RECOMP_FF_UPSTREAM") != NULL;
+        no_ff = getenv("RECOMP_NO_FF") != NULL;
+        kinds = k ? (int)strtol(k, NULL, 0) : 7;
+    }
+    {
+        /* RECOMP_GPU_CONTROL=<file>, re-read once a second, for A/B work in
+         * one run: "kinds=N" overrides RECOMP_GPU_KINDS, and "tex=<hex>",
+         * "blend=<sfactor hex>/<dfactor hex>", "ztest=<0|1>", "prog=<hex>"
+         * send the batches that match all of the given ones to the CPU. */
+        static const char *path = (const char *)-1;
+        static DWORD last;
+        static uint32_t f_tex, f_sb, f_db, f_prog, f_on;
+        static int f_zt = -1;
+        if (path == (const char *)-1)
+            path = getenv("RECOMP_GPU_CONTROL");
+        if (path && GetTickCount() - last > 1000) {
+            DWORD now = GetTickCount();
+            FILE *f = fopen(path, "rb");
+            char line[128];
+            last = now;
+            f_on = f_tex = f_sb = f_db = f_prog = 0;
+            f_zt = -1;
+            while (f && fgets(line, sizeof line, f)) {
+                unsigned a, b;
+                if (sscanf(line, "kinds=%i", &kinds) == 1) continue;
+                if (sscanf(line, "tex=%x", &a) == 1) { f_tex = a; f_on = 1; }
+                if (sscanf(line, "blend=%x/%x", &a, &b) == 2) { f_sb = a; f_db = b; f_on = 1; }
+                if (sscanf(line, "ztest=%u", &a) == 1) { f_zt = (int)a; f_on = 1; }
+                if (sscanf(line, "prog=%x", &a) == 1) { f_prog = a; f_on = 1; }
+                if (sscanf(line, "flush=%u", &a) == 1) {  /* one full write-back per new value */
+                    static unsigned flushed;
+                    if (a != flushed) {
+                        flushed = a;
+                        s_gpu_pending = 1;
+                        gpu_before_cpu();
+                        fprintf(stderr, "[GPU-D3D11] control: flush %u\n", a);
+                    }
+                }
+                if (sscanf(line, "stall=%u", &b) == 1) {  /* sleep the executor once per new value */
+                    static unsigned stalled;
+                    if (b != stalled) {
+                        stalled = b;
+                        fprintf(stderr, "[GPU-D3D11] control: stall %u ms\n", b);
+                        Sleep(b);
+                    }
+                }
+                if (sscanf(line, "slow=%u", &b) == 1 && b)  /* sleep b ms per flip-sized slice */
+                    Sleep(b);
+                if (sscanf(line, "sync=%u", &a) == 1) {   /* write-back without refresh */
+                    static unsigned synced;
+                    if (a != synced) {
+                        synced = a;
+                        nv2a_gpu_sync();
+                        fprintf(stderr, "[GPU-D3D11] control: sync %u\n", a);
+                    }
+                }
+            }
+            if (f)
+                fclose(f);
+        }
+        if (f_on && (!f_tex || s_gpu.texs[0].offset == f_tex)
+            && (!f_sb || (s_gpu.blend_enable && s_gpu.blend_sfactor == f_sb && s_gpu.blend_dfactor == f_db))
+            && (f_zt < 0 || (int)s_gpu.depth_test == f_zt)
+            && (!f_prog || s_gpu.rc.stage_program == f_prog))
+            return -1;
+    }
+    /* Points and lines (Deathrow's aiming dots and lines) stay on the CPU,
+     * which widens them into quads ([gx1]/[gx3]); the GPU path would draw
+     * one-pixel lines and refuses sized points. */
+    if (s_gpu.prim == NV_PRIM_POINTS || prim_is_line(s_gpu.prim))
+        return -1;
+    if (batch_uses_program())
+        kind = GPU_PROGRAM;
+    else if (ff_up && batch_is_ffp())
+        return -1;                       /* upstream lighting: CPU only */
+    else if (!batch_is_screen_space())
+        kind = no_ff ? -1 : GPU_FIXED;
+    else
+        kind = GPU_SCREEN;
+    return kind >= 0 && (kinds & (1 << kind)) ? kind : -1;
+}
+
+/* Draw the current batch on the GPU. 1 = drawn; 0 = the CPU draws it. */
+static int gpu_raster_batch(int kind)
+{
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset();
+    Nv2aGpuDraw *st = &s_gstate;
+    uint32_t i, n = s_gpu.idx_count, stage;
+    uint64_t want = (uint64_t)n * 3;
+    uint32_t vcap = want < NV2A_GPU_MAX_VERTICES ? (uint32_t)want : NV2A_GPU_MAX_VERTICES;
+    uint32_t icap = want < NV2A_GPU_MAX_INDICES ? (uint32_t)want : NV2A_GPU_MAX_INDICES;
+    int ok = 1;
+
+    if (!s_gpu.rc_seen)
+        return gpu_reject("combiners not programmed yet");
+    if (surface_bpp() != 4)
+        return gpu_reject("16-bit colour surface");
+    if (!s_gpu.clip_w || !s_gpu.clip_h || !s_gpu.color_offset || !surface_begin_batch(mem))
+        return gpu_reject("no usable colour surface");
+    if (s_pofs_mode < 0) {                     /* [zf2], as raster_xf_triangle */
+        const char *v = getenv("RECOMP_POFS");
+        s_pofs_mode = !v ? 0 : (v[0] == 's' ? 2 : (v[0] == '0' ? 0 : 1));
+    }
+    if (s_pofs_mode == 2 && s_pofs_en[2] && (s_pofs_scale != 0.0f || s_pofs_bias != 0.0f))
+        return gpu_reject("RECOMP_POFS=skip batch");
+    if (vcap > s_gv_cap) {
+        Nv2aGpuVertex *g = (Nv2aGpuVertex *)realloc(s_gv, (size_t)vcap * sizeof *s_gv);
+        if (!g)
+            return gpu_reject("vertex staging allocation");
+        s_gv = g;
+        s_gv_cap = vcap;
+    }
+    if (icap > s_gi_cap) {
+        uint32_t *g = (uint32_t *)realloc(s_gi, (size_t)icap * sizeof *s_gi);
+        if (!g)
+            return gpu_reject("index staging allocation");
+        s_gi = g;
+        s_gi_cap = icap;
+    }
+
+    memset(st, 0, sizeof *st);
+    st->color = s_surface;
+    st->width = s_gpu.clip_x + s_gpu.clip_w;
+    if (st->width > s_gpu.pitch / 4)
+        st->width = s_gpu.pitch / 4;
+    st->height = s_gpu.clip_y + s_gpu.clip_h;
+    st->pitch = s_gpu.pitch;
+    st->bytes_per_pixel = 4;
+    st->position_scale[0] = aa_scale_x();         /* [rb14] AA surfaces */
+    st->position_scale[1] = aa_scale_y();
+    st->clip_x = s_gpu.clip_x;
+    st->clip_y = s_gpu.clip_y;
+    st->clip_width = s_gpu.clip_w;
+    st->clip_height = s_gpu.clip_h;
+    st->stage_program = s_gpu.rc.stage_program;
+    gpu_combiners(&st->combiners);
+    st->shader_clip_mode = s_gpu.clip_plane_mode;
+    st->shader_other_stage_input = s_reg[0x1E78 / 4];
+    st->shader_dot_mapping = s_reg[0x1E74 / 4];
+    for (i = 0; i < 3; i++)
+        st->shader_eye_vector[i] = reg_f(0x181C + 4 * i);
+    st->shader_eye_vector_valid = 7;
+    st->alpha_enable = s_gpu.alpha_test;
+    st->alpha_function = s_gpu.alpha_func;
+    st->alpha_reference = s_gpu.alpha_ref;
+    st->control0 = s_reg[0x0290 / 4];
+    st->fog_enable = s_gpu.fog_enable;
+    st->fog_mode = s_gpu.fog_mode;
+    for (i = 0; i < 3; i++)
+        st->fog_parameters[i] = reg_f(0x09C0 + 4 * i);
+    st->fog_gen_mode = s_reg[0x02A0 / 4];
+    for (i = 0; i < 4; i++)
+        st->fog_plane[i] = reg_f(0x09D0 + 4 * i);
+    st->depth_enable = s_gpu.depth_test;
+    st->depth_function = s_gpu.depth_func;
+    st->depth_mask = s_gpu.depth_mask;
+    st->zmin_max_control = s_reg[0x1D78 / 4];
+    st->depth_clip_min = reg_f(0x0394);
+    st->depth_clip_max = reg_f(0x0398);
+    st->depth_range_valid = s_reg[0x0398 / 4] ? 3u : 0u;
+    /* The CPU rasteriser has never done stencil; the GPU does. Deathrow's
+     * arena uses GREATER/REPLACE stencil passes, and without them large
+     * stray triangles show. RECOMP_GPU_STENCIL=0 turns it off, for A/B. */
+    {
+        static int stencil = -1;
+        if (stencil < 0) {
+            const char *v = getenv("RECOMP_GPU_STENCIL");
+            stencil = !(v && v[0] == '0');
+        }
+        st->stencil_enable = stencil ? s_reg[0x032C / 4] : 0;
+    }
+    st->stencil_function = s_reg[0x0364 / 4];
+    st->stencil_reference = s_reg[0x0368 / 4] & 0xFFu;
+    st->stencil_read_mask = s_reg[0x036C / 4] & 0xFFu;
+    st->stencil_write_mask = s_reg[0x0360 / 4] & 0xFFu;
+    st->stencil_fail = s_reg[0x0370 / 4];
+    st->stencil_depth_fail = s_reg[0x0374 / 4];
+    st->stencil_pass = s_reg[0x0378 / 4];
+    st->cull_enable = s_reg[0x0308 / 4];
+    st->cull_face = s_reg[0x039C / 4];
+    st->front_face = s_reg[0x03A0 / 4];
+    st->polygon_front = s_reg[0x038C / 4];
+    st->polygon_back = s_reg[0x0390 / 4];
+    if (s_pofs_mode == 1) {
+        st->polygon_offset_enable = (s_pofs_en[0] ? 1u : 0u) | (s_pofs_en[1] ? 2u : 0u)
+                                  | (s_pofs_en[2] ? 4u : 0u);
+        st->polygon_offset_scale = s_pofs_scale;
+        st->polygon_offset_bias = s_pofs_bias;
+    }
+    st->depth_format = (s_gpu.format >> 4) & 15u;
+    st->depth_pitch = s_reg[0x020C / 4] >> 16;
+    {
+        /* Distinct depth-range states, once each: the GPU path culls depth
+         * outside SET_CLIP_MIN/MAX (or clamps it), the CPU path does neither. */
+        static uint32_t seen[48][4];
+        static int nseen;
+        uint32_t key[4] = { st->zmin_max_control ^ (st->stencil_enable ? st->stencil_function << 8 ^ st->stencil_pass << 16 ^ st->stencil_fail << 4 ^ st->stencil_depth_fail << 12 : 0),
+                            s_reg[0x0394 / 4], s_reg[0x0398 / 4],
