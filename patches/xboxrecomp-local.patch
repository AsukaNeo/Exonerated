+/* Each buffer swap waits for the next vblank, as scanout would. The CPU rasteriser
+ * is slow enough that it never mattered; the GPU path flips the title screen
+ * well over a thousand times a second, and a title that counts frames then
+ * runs its clocks that much faster. RECOMP_GPU_FLIP_HZ sets the rate; 0 lets
+ * flips through at once, for measuring throughput.
+ *
+ * 30 by default, a stopgap: Deathrow runs a locked 60 on hardware, but here
+ * its game clock runs about twice as fast at 60 swaps a second and right at
+ * 30 (judged in play, 2026-10-17). Something in the runtime hands it double
+ * time per frame (a vblank or frame count); until that is found, 30 keeps the
+ * game at the right speed. */
+static void gpu_pace_flip(void)
+{
+    static int hz = -1;
+    static LARGE_INTEGER freq, next;
+    LARGE_INTEGER now;
+    LONGLONG period;
+
+    if (s_gpu_on <= 0)
+        return;
+    if (hz < 0) {
+        const char *v = getenv("RECOMP_GPU_FLIP_HZ");
+        hz = v ? atoi(v) : 30;
+        QueryPerformanceFrequency(&freq);
+        fprintf(stderr, "[GPU-D3D11] flips paced to %d Hz (RECOMP_GPU_FLIP_HZ)\n", hz);
+    }
+    if (hz <= 0)
+        return;
+    period = freq.QuadPart / hz;
+    QueryPerformanceCounter(&now);
+    if (!next.QuadPart || now.QuadPart - next.QuadPart > period)
+        next.QuadPart = now.QuadPart;        /* behind by over a frame: no catch-up burst */
+    else
+        while (now.QuadPart < next.QuadPart) {
+            LONGLONG ms = (next.QuadPart - now.QuadPart) * 1000 / freq.QuadPart;
+            if (ms > 1)
+                Sleep((DWORD)(ms - 1));
+            else
+                SwitchToThread();
+            QueryPerformanceCounter(&now);
+        }
+    next.QuadPart += period;
+    {
+        static unsigned calls;
+        static LARGE_INTEGER t0;
+        if (!t0.QuadPart)
+            t0 = now;
+        if (++calls == 600) {
+            fprintf(stderr, "[GPU-D3D11] paced swaps: 600 in %.2f s\n",
+                    (double)(now.QuadPart - t0.QuadPart) / (double)freq.QuadPart);
+            calls = 0;
+            t0 = now;
+        }
+    }
+}
