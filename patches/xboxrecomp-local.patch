+
+static void gd_release(gd_lock_t *l)
+{
+    if (l->owner != (LONG)GetCurrentThreadId())
+        return;
+    if (--l->count <= 0) {
+        l->count = 0;
+        InterlockedExchange(&l->owner, 0);
+    }
