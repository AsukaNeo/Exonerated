+/* [gx5] A point's size in output pixels: SET_POINT_PARAMS attenuation
+ * when enabled (xemu's formula, eye distance taken as w), else the size
+ * register in eighths of a pixel. */
+static float point_size_px(const Nv2aVshOutput *a)
+{
+    float size;
+    if (s_reg[0x0318 / 4] & 1) {
+        float p[8], d = a->pos[3], q;
+        int i;
+        for (i = 0; i < 8; i++)
