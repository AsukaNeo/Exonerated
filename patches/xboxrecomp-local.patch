@@ -630,3 +630,75 @@ int usb_gamepad_report(int pad, uint8_t *out, int max)
     pad_script_apply(pad, out);
     return 20;
 }
+
+/* ---- the output report: rumble ------------------------------------------ */
+
+/*
+ * Six bytes, fixed like the input report:
+ *
+ *   0      report id, always 0
+ *   1      length, always 6
+ *   2..3   left (low-frequency) motor, 0..65535, little endian
+ *   4..5   right (high-frequency) motor
+ *
+ * which is XInput's XINPUT_VIBRATION as it stands, so the speeds go to the
+ * host pad unchanged. Only a change is sent on: a title refreshes its rumble
+ * every frame, and XInputSetState to a wireless pad is not free.
+ *
+ * RECOMP_RUMBLE=0 turns it off. A pad left buzzing when the process ends
+ * keeps buzzing on some drivers, so the motors are stopped at exit.
+ */
+static uint16_t s_rumble[USB_GAMEPAD_MAX][2];
+
+static void rumble_send(int pad, uint16_t left, uint16_t right)
+{
+    XBOX_VIBRATION v;
+    v.wLeftMotorSpeed = left;
+    v.wRightMotorSpeed = right;
+    xbox_InputSetState((DWORD)pad, &v);
+    s_rumble[pad][0] = left;
+    s_rumble[pad][1] = right;
+}
+
+static void rumble_stop_all(void)
+{
+    int pad;
+    for (pad = 0; pad < USB_GAMEPAD_MAX; pad++)
+        if (s_rumble[pad][0] || s_rumble[pad][1])
+            rumble_send(pad, 0, 0);
+}
+
+void usb_gamepad_output(int pad, const uint8_t *data, int len)
+{
+    static int enabled = -1;
+    static unsigned shown;
+    uint16_t left, right;
+
+    if (enabled < 0) {
+        const char *v = getenv("RECOMP_RUMBLE");
+        enabled = !(v && *v == '0');
+        if (enabled)
+            atexit(rumble_stop_all);
+    }
+    if (!enabled || pad < 0 || pad >= USB_GAMEPAD_MAX)
+        return;
+    if (len < 6 || data[0] != 0 || data[1] < 6) {
+        if (shown++ < 5) {
+            fprintf(stderr, "  [RUMBLE] pad %d: unexpected output report, %d "
+                    "bytes: %02X %02X ...\n", pad, len,
+                    len > 0 ? data[0] : 0, len > 1 ? data[1] : 0);
+            fflush(stderr);
+        }
+        return;
+    }
+    left  = (uint16_t)(data[2] | data[3] << 8);
+    right = (uint16_t)(data[4] | data[5] << 8);
+    if (left == s_rumble[pad][0] && right == s_rumble[pad][1])
+        return;
+    if (shown++ < 40) {
+        fprintf(stderr, "  [RUMBLE] pad %d: left %u right %u\n", pad,
+                (unsigned)left, (unsigned)right);
+        fflush(stderr);
+    }
+    rumble_send(pad, left, right);
+}
