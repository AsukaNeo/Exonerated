+static void ov_item(int i, const char **label, char *value, size_t n)
+{
+    static const char *const labels[OV_COUNT] = {
+        "Fullscreen", "VSync", "Filter", "Scale", "Renderer", "Render resolution",
+        "Widescreen (16:9)", "FPS counter", "Rumble", "Stick dead zone", "Take screenshot",
+        "Save settings", "Close"
+    };
+    if (s_gpu_pending < 0)
+        s_gpu_pending = s_cfg.gpu;
+    if (!s_render_pending)
+        s_render_pending = s_cfg.render_scale;
+    if (s_wide_pending < 0)
+        s_wide_pending = s_cfg.widescreen;
+    *label = labels[i];
+    value[0] = 0;
+    switch (i) {
+    case OV_FULLSCREEN: snprintf(value, n, "%s", s_is_fullscreen ? "On" : "Off"); break;
+    case OV_VSYNC:      snprintf(value, n, "%s", s_cfg.vsync ? "On" : "Off"); break;
+    case OV_FILTER:     snprintf(value, n, "%s", s_cfg.filter == FILTER_SHARP ? "Sharp"
+                                 : s_cfg.filter == FILTER_BILINEAR ? "Bilinear" : "Nearest"); break;
+    case OV_SCALE:      snprintf(value, n, "%s", s_cfg.scale == SCALE_FIT ? "Fit (4:3)"
+                                 : s_cfg.scale == SCALE_INTEGER ? "Integer" : "Stretch"); break;
+    case OV_GPU:
+        snprintf(value, n, "%s%s", s_gpu_pending ? "GPU" : "Software",
+                 s_gpu_pending != s_cfg.gpu ? " after save + restart" : "");
+        break;
+    case OV_RENDER:
+        if (!s_cfg.gpu && s_render_pending == s_cfg.render_scale)
+            snprintf(value, n, "%dx (GPU renderer only)", s_render_pending);
+        else if (s_render_pending == s_cfg.render_scale)
+            snprintf(value, n, "%dx (%ux%u)", s_render_pending,
+                     s_fb_width * (uint32_t)s_render_pending, s_fb_height * (uint32_t)s_render_pending);
+        else
+            snprintf(value, n, "%dx after save + restart", s_render_pending);
+        break;
+    case OV_WIDE:
+        snprintf(value, n, "%s%s", s_wide_pending ? "On" : "Off",
+                 s_wide_pending != s_cfg.widescreen ? " after save + restart" : "");
+        break;
+    case OV_FPS:       snprintf(value, n, "%s", s_cfg.fps_counter ? "On" : "Off"); break;
+    case OV_RUMBLE:     snprintf(value, n, "%s", xbox_InputGetRumble() ? "On" : "Off"); break;
+    case OV_DEADZONE: {
+        int dz = xbox_InputGetDeadZone();
+        if (dz) snprintf(value, n, "%d%%", (dz * 100 + 16383) / 32767);
+        else    snprintf(value, n, "Off (game's own)");
+        break;
+    }
+    }
+}
