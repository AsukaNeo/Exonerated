+/* ---- settings overlay --------------------------------------------------- */
+
+/* F10, or Back+Start on the pad, opens a menu over the game: the display
+ * settings above, the FPS counter, rumble and the stick dead zone, a
+ * screenshot, and saving all of it to the ini. While it is open the title
+ * reads a pad at rest (xbox_InputSetSuspended), so moving through the menu
+ * does not also play; the game itself keeps running.
+ *
+ * Drawn with GDI into a 32-bit DIB the size of the client area -- real
+ * anti-aliased text at the window's own resolution -- then blended over the
+ * frame by the D3D11 presenter, or copied over it opaque by the GDI one. */
+enum { OV_FULLSCREEN, OV_VSYNC, OV_FILTER, OV_SCALE, OV_GPU, OV_RENDER, OV_WIDE, OV_FPS,
+       OV_RUMBLE, OV_DEADZONE, OV_SCREENSHOT, OV_SAVE, OV_CLOSE, OV_COUNT };
+
+/* The renderer, render scale and widescreen picked in the overlay. The back
+ * end is chosen and sizes its targets once, and the title reads its video
+ * settings once, so new values are saved for the next start rather than
+ * applied. -1 / 0 until the overlay first shows them. */
+static int s_gpu_pending = -1;
+static int s_render_pending;
+static int s_wide_pending = -1;
+
+static struct {
+    int       sel;
+    int       dirty;             /* the image needs drawing again */
+    int       release_wait;      /* closed: give the pad back once released */
+    HDC       dc;
+    HBITMAP   bmp, old;
+    uint32_t *bits;
+    int       w, h;
+    RECT      rects[2];          /* what is drawn: panel, FPS box */
+    int       nrects;
+    char      status[160];
+    DWORD     status_until;
+    char      fps[32];
+} s_ov;
+
+static const int s_dz_steps[] = { 0, 2000, 4000, 6000, 8000, 10000, 12000 };
+#define DZ_STEPS ((int)(sizeof s_dz_steps / sizeof s_dz_steps[0]))
+
+static void take_screenshot(void);
+
+static int ov_visible(void)
+{
+    return s_ov_open || (s_cfg.fps_counter && s_ov.fps[0]);
+}
+
+static void ov_status(const char *msg)
+{
+    snprintf(s_ov.status, sizeof s_ov.status, "%s", msg);
+    s_ov.status_until = GetTickCount() + 3000;
+    s_ov.dirty = 1;
+}
+
+static void ov_set_open(int on)
+{
+    if (on == (s_ov_open != 0))
+        return;
+    InterlockedExchange(&s_ov_open, on);
+    if (on) {
+        xbox_InputKeysClear();
+        xbox_InputSetSuspended(1);
+        s_ov.release_wait = 0;
+    } else {
+        /* Not yet: the B or Start that closed it is still held, and the
+         * title would take it as a press. ov_poll_pad lets go once it is
+         * up. */
+        s_ov.release_wait = 1;
+    }
+    s_ov.dirty = 1;
+}
