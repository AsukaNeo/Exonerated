+/* ---- GDI fallback ------------------------------------------------------- */
+
+static void gdi_present(HWND hwnd, HDC hdc, const BITMAPINFO *bi)
+{
+    RECT cr, bar;
+    int x, y, w, h;
+    HBRUSH black = (HBRUSH)GetStockObject(BLACK_BRUSH);
+
+    GetClientRect(hwnd, &cr);
+    fit_rect(cr.right, cr.bottom, &x, &y, &w, &h);
+    /* The bars around the picture, not the picture: no flicker. */
+    SetRect(&bar, 0, 0, cr.right, y);               FillRect(hdc, &bar, black);
+    SetRect(&bar, 0, y + h, cr.right, cr.bottom);   FillRect(hdc, &bar, black);
+    SetRect(&bar, 0, y, x, y + h);                  FillRect(hdc, &bar, black);
+    SetRect(&bar, x + w, y, cr.right, y + h);       FillRect(hdc, &bar, black);
+    SetStretchBltMode(hdc, s_cfg.filter == FILTER_NEAREST ? COLORONCOLOR
+                                                         : HALFTONE);
+    SetBrushOrgEx(hdc, 0, 0, NULL);
+    StretchDIBits(hdc, x, y, w, h, 0, 0, (int)s_fb_width, (int)s_fb_height,
+                  s_rgb, bi, DIB_RGB_COLORS, SRCCOPY);
+    /* The overlay's boxes, opaque: GDI has no per-pixel blend worth it. */
+    if (ov_visible()) {
+        int k;
+        ov_prepare(cr.right, cr.bottom);
+        for (k = 0; s_ov.dc && k < s_ov.nrects; k++) {
+            const RECT *r = &s_ov.rects[k];
+            BitBlt(hdc, r->left, r->top, r->right - r->left, r->bottom - r->top,
+                   s_ov.dc, r->left, r->top, SRCCOPY);
+        }
+    }
+}
