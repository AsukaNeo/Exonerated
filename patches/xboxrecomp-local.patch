+    for (i = 0; s_cfg.app[i]; i++)
+        s_cfg.app[i] = (char)tolower((unsigned char)s_cfg.app[i]);
+
+    /* RECOMP_INI, then the working directory (where play.sh runs), then
+     * beside the exe. */
+    s_ini[0] = 0;
+    if (v && *v) {
+        snprintf(s_ini, sizeof s_ini, "%s", v);
+    } else {
+        char cwd[MAX_PATH];
+        if (GetCurrentDirectoryA(sizeof cwd, cwd)) {
+            snprintf(s_ini, sizeof s_ini, "%s\\%s.ini", cwd, s_cfg.app);
+            if (!file_exists(s_ini))
+                s_ini[0] = 0;
+        }
+        if (!s_ini[0] && GetModuleFileNameA(NULL, exe, sizeof exe)) {
+            slash = strrchr(exe, '\\');
+            if (slash) {
+                *slash = 0;
+                snprintf(s_ini, sizeof s_ini, "%s\\%s.ini", exe, s_cfg.app);
+                if (!file_exists(s_ini))
+                    s_ini[0] = 0;
+            }
+        }
+    }
+
+    s_cfg.vsync = cfg_int("RECOMP_VSYNC", "vsync", 1) != 0;
+    s_cfg.fullscreen = cfg_int("RECOMP_FULLSCREEN", "fullscreen", 0) != 0;
+    s_cfg.window_scale = cfg_int("RECOMP_WINDOW_SCALE", "window_scale", 2);
+    if (s_cfg.window_scale < 1 || s_cfg.window_scale > 8)
+        s_cfg.window_scale = 2;
+
+    cfg_str("RECOMP_FILTER", "filter", "sharp", buf, sizeof buf);
+    s_cfg.filter = !_stricmp(buf, "nearest")  ? FILTER_NEAREST
+                 : !_stricmp(buf, "bilinear") ? FILTER_BILINEAR : FILTER_SHARP;
+    cfg_str("RECOMP_SCALE", "scale", "fit", buf, sizeof buf);
+    s_cfg.scale = !_stricmp(buf, "integer") ? SCALE_INTEGER
+                : !_stricmp(buf, "stretch") ? SCALE_STRETCH : SCALE_FIT;
+    cfg_str("RECOMP_PRESENT", "present", "d3d11", buf, sizeof buf);
+    s_cfg.gdi = !_stricmp(buf, "gdi");
+    cfg_str("RECOMP_WINDOW_TITLE", "title", RECOMP_APP_NAME,
+            s_cfg.title, sizeof s_cfg.title);
+    s_cfg.fps_counter = cfg_int("RECOMP_FPS_COUNTER", "fps_counter", 0) != 0;
+    s_cfg.rumble = cfg_int_in("input", "RECOMP_RUMBLE", "rumble", 1) != 0;
+    s_cfg.deadzone = cfg_int_in("input", "RECOMP_PAD_DEADZONE", "deadzone", 0);
+    s_cfg.render_scale = cfg_int("RECOMP_RENDER_SCALE", "render_scale", 1);
+    if (s_cfg.render_scale < 1 || s_cfg.render_scale > 4)
+        s_cfg.render_scale = 1;
+    s_cfg.widescreen = cfg_int("RECOMP_WIDESCREEN", "widescreen", 0) != 0;
+    /* The back end is chosen by RECOMP_PB_BACKEND, which the title's own
+     * start-up may have set from this same key; shown and saved here as
+     * gpu or software. */
+    v = getenv("RECOMP_PB_BACKEND");
+    if (v && *v)
+        s_cfg.gpu = !strcmp(v, "d3d11");
+    else {
+        cfg_str("RECOMP_RENDERER", "renderer", "software", buf, sizeof buf);
+        s_cfg.gpu = !_stricmp(buf, "gpu") || !_stricmp(buf, "d3d11");
+    }
+
+    fprintf(stderr, "  [FBWIN] settings%s%s: vsync %d filter %s scale %s "
+            "fullscreen %d window x%d present %s renderer %s x%d widescreen %d\n",
+            s_ini[0] ? " from " : " (no ini)", s_ini, s_cfg.vsync,
+            s_cfg.filter == FILTER_NEAREST ? "nearest"
+            : s_cfg.filter == FILTER_BILINEAR ? "bilinear" : "sharp",
+            s_cfg.scale == SCALE_INTEGER ? "integer"
+            : s_cfg.scale == SCALE_STRETCH ? "stretch" : "fit",
+            s_cfg.fullscreen, s_cfg.window_scale, s_cfg.gdi ? "gdi" : "d3d11",
+            s_cfg.gpu ? "gpu" : "software", s_cfg.render_scale, s_cfg.widescreen);
+}
