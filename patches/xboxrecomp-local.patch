+    want_disp = lvl >= DISPATCH_LEVEL;
+    want_int  = lvl >  DISPATCH_LEVEL;
+    if (!t_gd_isr && want_disp && !t_gd_irql_disp)
+        t_gd_irql_disp = gd_acquire(&s_gd_disp, host ? s_gd_host_ms : s_gd_ms,
