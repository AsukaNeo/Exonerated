+#include <tlhelp32.h>
+typedef struct { DWORD tid; ULONG64 r[8]; unsigned n; } sp1_ent;   /* [sp2] */
+static sp1_ent sp1_h[512];
+static int sp1_hn;
+static unsigned sp1_lost;
+
+static void sp1_add(DWORD tid, const ULONG64 *r)
+{
+    int i;
+    for (i = 0; i < sp1_hn; i++)
+        if (sp1_h[i].tid == tid && !memcmp(sp1_h[i].r, r, sizeof sp1_h[i].r)) {
+            sp1_h[i].n++;
+            return;
+        }
+    if (sp1_hn < (int)(sizeof sp1_h / sizeof sp1_h[0])) {
+        sp1_h[sp1_hn].tid = tid;
+        memcpy(sp1_h[sp1_hn].r, r, sizeof sp1_h[0].r);
+        sp1_h[sp1_hn].n = 1;
+        sp1_hn++;
+    } else {
+        sp1_lost++;
+    }
+}
+
+static void sp1_dump(unsigned total)
+{
+    int k, i, best;
+    fprintf(stderr, "[SAMPLE] ---- %u samples, %d distinct, %u not kept ----\n",
+            total, sp1_hn, sp1_lost);
+    for (k = 0; k < 40; k++) {
+        best = -1;
+        for (i = 0; i < sp1_hn; i++)
+            if (sp1_h[i].n && (best < 0 || sp1_h[i].n > sp1_h[best].n))
+                best = i;
+        if (best < 0)
+            break;
+        {
+            int j;
+            fprintf(stderr, "[SAMPLE] %5u tid %5lu rip rva", sp1_h[best].n,
+                    (unsigned long)sp1_h[best].tid);
+            for (j = 0; j < 8 && sp1_h[best].r[j]; j++)
+                fprintf(stderr, "%s0x%llX", j ? " <- " : " ", (unsigned long long)sp1_h[best].r[j]);
+            fprintf(stderr, "\n");
+        }
+        sp1_h[best].n = 0;
+    }
+    fflush(stderr);
+    sp1_hn = 0;
+    sp1_lost = 0;
+}
